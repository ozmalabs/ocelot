# --- python ---
__pycache__/
*.pyc
.env
.venv/
venv/
.venv-jsbsim-f16/

# --- editor / os ---
.DS_Store
*.swp
.aider*

# --- rust build artifacts ---
target/
runners/dsl/target/

# --- large datasets / corpora (not source, fetched/generated separately) ---
data/
recordings/
repeating_corpus/
naming_corpus/
pronunciation_corpus/

# --- experiment outputs / run artifacts (regenerable, huge) ---
results/*
# ...EXCEPT the enumerated red-test baseline and the sweeps it derives from.
# A BASELINE THAT LIVES IN ONE TREE IS NOT A BASELINE. results/ is gitignored,
# so results/failure_baseline.json existed ONLY in the canonical tree, and
# tests/test_failure_baseline_migrated.py SKIPS when it is absent -- meaning the
# gate that exists to stop a baseline from silently drifting was itself silently
# inert in every worktree every rung has ever created. Negated, deliberately.
!results/failure_baseline.json
!results/failure_baseline_sweep_BEFORE_triage.json
!results/failure_baseline_sweep_AFTER_triage.json
runs/
var/

# --- bulk-imported seed data (not hand-authored; grounded_lexicon.json exceeds GitHub's 100MB limit) ---
seeds/acquired/
seeds/grounded_lexicon.json

# --- local git worktrees / scratch / caches ---
.worktrees/
.bigtmp/
.pytest_cache/
.ruff_cache/
.claude/

# --- LaTeX build artefacts (regenerable from .tex; churn on every build) ---
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz

