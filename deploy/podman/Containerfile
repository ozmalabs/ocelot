# Build the native PyO3 extension from the Rust source that ships with this
# image. The extension uses abi3, so the Rust and Python build-stage versions
# need not match the runtime Python minor version.
FROM docker.io/library/rust:1.87-bookworm AS native-build
WORKDIR /src/runners/dsl
COPY runners/dsl/Cargo.toml runners/dsl/Cargo.lock ./
COPY runners/dsl/src ./src
RUN cargo build --locked --release --lib

FROM docker.io/library/python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=0 \
    PYTHONPATH=/app/runners/dsl/python:/app \
    HOME=/var/lib/ocelot \
    OCELOT_API_HOST=0.0.0.0 \
    OCELOT_API_PORT=8790 \
    OCELOT_STATE_DIR=/var/lib/ocelot/api

WORKDIR /app
COPY deploy/podman/requirements-api.txt /tmp/requirements-api.txt
RUN pip install --no-cache-dir --disable-pip-version-check \
      -r /tmp/requirements-api.txt \
    && groupadd --gid 10001 ocelot \
    && useradd --uid 10001 --gid 10001 --home-dir /var/lib/ocelot \
         --no-create-home --shell /usr/sbin/nologin ocelot \
    && install -d -o 10001 -g 10001 -m 0700 /var/lib/ocelot/api

COPY domains /app/domains
COPY substrate /app/substrate
COPY seeds /app/seeds
COPY scripts /app/scripts
COPY runners/dsl/python/substrate_rs /app/runners/dsl/python/substrate_rs
COPY --from=native-build /src/runners/dsl/target/release/libsubstrate_rs.so \
     /app/runners/dsl/python/substrate_rs/_native.abi3.so

USER 10001:10001
EXPOSE 8790
ENTRYPOINT ["python3", "-m", "scripts.ocelot_api"]
