{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocelot.local/evaluation/substrate_capability/run_manifest.schema.json",
  "title": "Substrate Capability Benchmark Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_state",
    "protocol",
    "hypothesis",
    "source",
    "build",
    "environment",
    "workload",
    "conditions",
    "analysis",
    "custody",
    "artifacts",
    "started_at_unix_ns",
    "finished_at_unix_ns",
    "records"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "run_state": { "enum": ["discovery", "pilot", "confirmatory", "replication"] },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "primary_metric", "decision_rule"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "primary_metric": { "type": "string", "minLength": 1 },
        "decision_rule": { "type": "string", "minLength": 1 },
        "secondary_metrics": { "type": "array", "items": { "type": "string" } },
        "preregistration_ref": { "type": ["string", "null"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty", "patch_sha256"],
      "properties": {
        "commit": { "type": "string", "minLength": 7 },
        "dirty": { "type": "boolean" },
        "patch_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rustc", "python", "dependency_lock_sha256", "build_flags", "native_artifacts"],
      "properties": {
        "rustc": { "type": ["string", "null"] },
        "python": { "type": ["string", "null"] },
        "dependency_lock_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "build_flags": { "type": "array", "items": { "type": "string" } },
        "native_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "cpu_model", "cpu_count", "ram_bytes", "accelerators", "runtime_config"],
      "properties": {
        "os": { "type": "string" },
        "architecture": { "type": "string" },
        "cpu_model": { "type": ["string", "null"] },
        "cpu_count": { "type": ["integer", "null"], "minimum": 1 },
        "ram_bytes": { "type": ["integer", "null"], "minimum": 1 },
        "accelerators": { "type": "array", "items": { "type": "string" } },
        "runtime_config": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "family", "generator_sha256", "data_sha256", "split", "instance_count", "input_dimensions"],
      "properties": {
        "capability_id": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "generator_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "data_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "split": { "enum": ["development", "confirmatory", "replication", "not-applicable"] },
        "instance_count": { "type": "integer", "minimum": 0 },
        "input_dimensions": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": ["string", "number", "boolean", "null"] },
              { "type": "array", "items": { "type": ["string", "number", "boolean", "null"] } }
            ]
          }
        }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition_id", "role", "implementation", "entrypoint", "budget"],
        "properties": {
          "condition_id": { "type": "string", "minLength": 1 },
          "role": { "enum": ["candidate", "baseline", "ablation", "positive-control", "negative-control"] },
          "implementation": { "type": "string", "minLength": 1 },
          "entrypoint": { "type": "string", "minLength": 1 },
          "state_owner": { "type": ["string", "null"] },
          "budget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["wall_time_ms", "cpu_time_ms", "memory_bytes"],
            "properties": {
              "wall_time_ms": { "type": ["integer", "null"], "minimum": 1 },
              "cpu_time_ms": { "type": ["integer", "null"], "minimum": 1 },
              "memory_bytes": { "type": ["integer", "null"], "minimum": 1 }
            }
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_sha256", "primary_unit", "interval_method", "multiple_comparison_rule", "exclusion_policy"],
      "properties": {
        "analysis_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "primary_unit": { "type": "string", "minLength": 1 },
        "interval_method": { "type": "string", "minLength": 1 },
        "multiple_comparison_rule": { "type": "string", "minLength": 1 },
        "exclusion_policy": { "type": "string", "minLength": 1 },
        "thresholds": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } }
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "description"],
      "properties": {
        "classification": { "enum": ["project-self-custodied", "technically-separated", "external-evaluator", "unknown"] },
        "description": { "type": "string" },
        "evaluator_role": { "type": ["string", "null"] }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "stdout_ref", "stderr_ref", "raw_records_ref", "resource_log_ref", "result_ref"],
      "properties": {
        "command": { "type": "array", "items": { "type": "string" } },
        "stdout_ref": { "type": ["string", "null"] },
        "stderr_ref": { "type": ["string", "null"] },
        "raw_records_ref": { "type": ["string", "null"] },
        "resource_log_ref": { "type": ["string", "null"] },
        "result_ref": { "type": ["string", "null"] }
      }
    },
    "started_at_unix_ns": { "type": "integer", "minimum": 0 },
    "finished_at_unix_ns": { "type": "integer", "minimum": 0 },
    "records": {
      "type": "array",
      "items": { "$ref": "instance_record.schema.json" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
  }
}
