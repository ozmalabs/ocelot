  assertion.aud == 'https://sts.googleapis.com' &&
  assertion.iss == 'https://confidentialcomputing.googleapis.com' &&
  assertion.submods.container.image_digest == 'sha256:REVIEWED_EXACT_64_HEX_DIGEST' &&
  assertion.submods.gce.project_number == 'REVIEWED_PROJECT_NUMBER' &&
  assertion.submods.gce.project_id == 'REVIEWED_PROJECT_ID' &&
  assertion.submods.gce.zone == 'REVIEWED_ZONE' &&
  assertion.dbgstat == 'disabled-since-boot' &&
  assertion.swname == 'CONFIDENTIAL_SPACE' &&
  assertion.hwmodel == 'GCP_AMD_SEV' &&
  assertion.submods.container.env.P5R0_EXPECTED_WORKLOAD == 'evaluator' &&
