        "name": "locative_inversion_subject",
        "priority": 50.0,
        "note": "VS / locative inversion: a fronted adjunct PP consuming the whole pre-verb span (adj_end >= vi) makes the post-verb nominal the post-posed SUBJECT ('Into the room walked a tall man').",
        "guard_json": "{\"type\":\"And\",\"items\":[{\"type\":\"Not\",\"arg\":{\"type\":\"Lt\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"lead_pp\"},\"b\":{\"type\":\"Lit\",\"value\":1.0}}},{\"type\":\"Not\",\"arg\":{\"type\":\"Lt\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"adj_end\"},\"b\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"main_verb_index\"}}},{\"type\":\"Not\",\"arg\":{\"type\":\"Eq\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"r_obj_span_head\"},\"b\":{\"type\":\"Lit\",\"value\":\"\"}}}]}",
        "effects_json": "[[\"r_subj\",{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"r_obj_span_head\"}],[\"r_subj_span\",{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"r_obj_span\"}],[\"r_inverted\",{\"type\":\"Lit\",\"value\":1.0}]]"
      }
    },
