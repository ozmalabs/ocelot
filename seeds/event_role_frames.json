      "attrs": {
        "codebook": "event_roles",
        "name": "acc_object",
        "priority": 20.0,
        "note": "CASE: a non-prepositional accusative pronoun (him/her/them) distinct from the subject binds OBJECT wherever it sits.",
        "guard_json": "{\"type\":\"And\",\"items\":[{\"type\":\"Not\",\"arg\":{\"type\":\"Lt\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"acc_idx\"},\"b\":{\"type\":\"Lit\",\"value\":0.0}}},{\"type\":\"Not\",\"arg\":{\"type\":\"Eq\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"acc_surface\"},\"b\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"r_subj\"}}}]}",
        "effects_json": "[[\"r_obj\",{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"acc_surface\"}],[\"r_obj_span\",{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"acc_surface\"}],[\"r_obj_span_head\",{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"acc_surface\"}]]"
      }
    },
    {
      "type": "VerbFrame",
      "attrs": {
        "codebook": "event_roles",
        "name": "acc_fronted",
        "priority": 21.0,
        "note": "a pre-verbal accusative pronoun (acc_i < vi) is a fronted object \u2014 inversion.",
        "guard_json": "{\"type\":\"And\",\"items\":[{\"type\":\"And\",\"items\":[{\"type\":\"Not\",\"arg\":{\"type\":\"Lt\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"acc_idx\"},\"b\":{\"type\":\"Lit\",\"value\":0.0}}},{\"type\":\"Not\",\"arg\":{\"type\":\"Eq\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"acc_surface\"},\"b\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"r_subj\"}}}]},{\"type\":\"Lt\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"acc_idx\"},\"b\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"main_verb_index\"}}]}",
        "effects_json": "[[\"r_inverted\",{\"type\":\"Lit\",\"value\":1.0}]]"
      }
    },
    {
      "type": "VerbFrame",
      "attrs": {
        "codebook": "event_roles",
        "name": "clear_collision",
        "priority": 30.0,
        "note": "a default-SVO object that collided with the (re)bound subject is spurious \u2014 clear it.",
        "guard_json": "{\"type\":\"And\",\"items\":[{\"type\":\"Not\",\"arg\":{\"type\":\"Eq\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"r_obj\"},\"b\":{\"type\":\"Lit\",\"value\":\"\"}}},{\"type\":\"Eq\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"r_obj\"},\"b\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"r_subj\"}}]}",
        "effects_json": "[[\"r_obj\",{\"type\":\"Lit\",\"value\":\"\"}],[\"r_obj_span\",{\"type\":\"Lit\",\"value\":\"\"}],[\"r_obj_span_head\",{\"type\":\"Lit\",\"value\":\"\"}]]"
      }
    },
    {
      "type": "VerbFrame",
      "attrs": {
        "codebook": "event_roles",
        "name": "osv_fronted_object",
        "priority": 40.0,
        "note": "OSV: a pre-verbal nominative subject with the object still open takes the DP abutting the subject pronoun on its left as the fronted object ('the manxome foe he sought').",
        "guard_json": "{\"type\":\"And\",\"items\":[{\"type\":\"Not\",\"arg\":{\"type\":\"Lt\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"nom_idx\"},\"b\":{\"type\":\"Lit\",\"value\":0.0}}},{\"type\":\"Lt\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"nom_idx\"},\"b\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"main_verb_index\"}},{\"type\":\"Eq\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"r_obj\"},\"b\":{\"type\":\"Lit\",\"value\":\"\"}},{\"type\":\"Not\",\"arg\":{\"type\":\"Eq\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"fronted_head\"},\"b\":{\"type\":\"Lit\",\"value\":\"\"}}},{\"type\":\"Not\",\"arg\":{\"type\":\"Eq\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"fronted_head\"},\"b\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"r_subj\"}}}]}",
        "effects_json": "[[\"r_obj\",{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"fronted_head\"}],[\"r_obj_span\",{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"fronted_span\"}],[\"r_obj_span_head\",{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"fronted_head\"}],[\"r_inverted\",{\"type\":\"Lit\",\"value\":1.0}]]"
