        "effects_json": "[[\"r_obj\",{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"pp_head\"}],[\"r_obj_span\",{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"pp_span\"}]]"
      }
    },
    {
      "type": "VerbFrame",
      "attrs": {
        "codebook": "event_roles",
        "name": "locative_inversion_no_oblique",
        "priority": 52.0,
        "note": "\u2026else (no distinct PP head) the inverted clause has no core object.",
        "guard_json": "{\"type\":\"And\",\"items\":[{\"type\":\"And\",\"items\":[{\"type\":\"Not\",\"arg\":{\"type\":\"Lt\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"lead_pp\"},\"b\":{\"type\":\"Lit\",\"value\":1.0}}},{\"type\":\"Not\",\"arg\":{\"type\":\"Lt\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"adj_end\"},\"b\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"main_verb_index\"}}},{\"type\":\"Not\",\"arg\":{\"type\":\"Eq\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"r_obj_span_head\"},\"b\":{\"type\":\"Lit\",\"value\":\"\"}}}]},{\"type\":\"Or\",\"items\":[{\"type\":\"Eq\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"pp_head\"},\"b\":{\"type\":\"Lit\",\"value\":\"\"}},{\"type\":\"Eq\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"pp_head\"},\"b\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"r_subj\"}}]}]}",
        "effects_json": "[[\"r_obj\",{\"type\":\"Lit\",\"value\":\"\"}],[\"r_obj_span\",{\"type\":\"Lit\",\"value\":\"\"}]]"
