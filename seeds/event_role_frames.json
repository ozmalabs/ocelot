        "priority": 0.0,
        "note": "default SVO reading \u2014 subject before the verb, object after (PP-truncated); the byte-for-byte position baseline every override starts from.",
        "guard_json": "{\"type\":\"Not\",\"arg\":{\"type\":\"Lt\",\"a\":{\"type\":\"Lit\",\"value\":1.0},\"b\":{\"type\":\"Lit\",\"value\":0.0}}}",
        "effects_json": "[[\"r_subj\",{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"def_subj\"}],[\"r_subj_span\",{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"subj_span\"}],[\"r_obj\",{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"def_obj\"}],[\"r_obj_span\",{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"obj_span\"}],[\"r_obj_span_head\",{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"inv_subj_head\"}],[\"r_inverted\",{\"type\":\"Lit\",\"value\":0.0}]]"
      }
    },
    {
      "type": "VerbFrame",
      "attrs": {
        "codebook": "event_roles",
        "name": "nom_subject",
