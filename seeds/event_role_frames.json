        "guard_json": "{\"type\":\"And\",\"items\":[{\"type\":\"Not\",\"arg\":{\"type\":\"Eq\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"obl_canon_head\"},\"b\":{\"type\":\"Lit\",\"value\":\"\"}}},{\"type\":\"Not\",\"arg\":{\"type\":\"Lt\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"obl_animate\"},\"b\":{\"type\":\"Lit\",\"value\":1.0}}},{\"type\":\"Not\",\"arg\":{\"type\":\"Lt\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"obl_role_ok\"},\"b\":{\"type\":\"Lit\",\"value\":1.0}}},{\"type\":\"Not\",\"arg\":{\"type\":\"Eq\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"obl_canon_head\"},\"b\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"r_subj\"}}},{\"type\":\"Not\",\"arg\":{\"type\":\"Eq\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"obl_canon_head\"},\"b\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"r_obj\"}}}]}",
