      "type": "VerbFrame",
      "attrs": {
        "codebook": "event_roles",
        "name": "nom_postposed",
        "priority": 11.0,
        "note": "a post-verbal nominative subject (nom_i > vi) marks a verb-subject inversion ('rested he').",
        "guard_json": "{\"type\":\"And\",\"items\":[{\"type\":\"Not\",\"arg\":{\"type\":\"Lt\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"nom_idx\"},\"b\":{\"type\":\"Lit\",\"value\":0.0}}},{\"type\":\"Gt\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"nom_idx\"},\"b\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"main_verb_index\"}}]}",
        "effects_json": "[[\"r_inverted\",{\"type\":\"Lit\",\"value\":1.0}]]"
      }
    },
