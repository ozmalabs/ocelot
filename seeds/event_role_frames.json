        "note": "CASE: a nominative pronoun (he/she/they) binds SUBJECT wherever it sits, overriding the positional subject.",
        "guard_json": "{\"type\":\"Not\",\"arg\":{\"type\":\"Lt\",\"a\":{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"nom_idx\"},\"b\":{\"type\":\"Lit\",\"value\":0.0}}}",
        "effects_json": "[[\"r_subj\",{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"nom_surface\"}],[\"r_subj_span\",{\"type\":\"Attr\",\"node\":{\"type\":\"Var\",\"name\":\"c\"},\"key\":\"nom_surface\"}]]"
      }
    },
