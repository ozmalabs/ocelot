{
 "seed": {
  "id": "render_lua_statements",
  "version": "1.0.0",
  "language": "lua",
  "depends_on": []
 },
 "doc": "Statement-grain LUA renderer as graph-resident RenderRules (P5 track B). Hub Program IR -> runnable lua (lua5.4 + luajit), inverse of seeds/lua_correspondence.json (P2) including the 1-based subscript shift, the inclusive-stop numeric-for shift, the ipairs desugar and the repeat fold \u2014 the cross-frame maps run in BOTH directions now. Installed by domains/render_rust_lua.py:install_renderer(sub, 'lua'); the teachable subset can arrive through the runtime render-gap -> self-teacher -> install_render_rule loop (teach_spec entries; tests/test_teach_lua_renderer_migrated.py precedent).",
 "render_gaps": [
  "IfThenElse",
  "ProgTryOr",
  "ProgRaise",
  "ProgImportStmt",
  "ProgAttrGet",
  "ProgAttrSet",
  "ProgTupleUnpack",
  "ProgIsOp",
  "ProgComprehensionList",
  "ProgComprehensionGen"
 ],
 "render_rules": [
  {
   "head": "Lit",
   "binding_pattern": [
    "value"
   ],
   "template": {
    "type": "Cat",
    "items": [
     {
      "type": "ToJsonString",
      "value": {
       "type": "Slot",
       "name": "value"
      }
     }
    ]
   },
   "note": "ToJsonString spelling: true/false/nil-less ints/floats, double-quoted JSON-escaped strings (valid lua for the printable subset; exotic \\uXXXX escapes are a recorded residual). TEACH DELTA: the loop-carriable twin is the bare-Slot (int-faithful only) form \u2014 exactly the original taught-Lua precedent's Lit rule; bools/strings need ToJsonString, which the teach spec grammar cannot carry.",
   "teachable": true,
   "teach_spec": [
    "Cat",
    [
     "Slot",
     "value"
    ]
   ]
  },
  {
   "head": "Var",
   "binding_pattern": [
    "name"
   ],
   "template": {
    "type": "Cat",
