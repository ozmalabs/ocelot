                      "type": "Lit",
                      "value": 0.0
                    }
                  ]
                }
              },
              "b": {
                "type": "Count",
                "source": {
                  "type": "Neighbours",
                  "node": {
                    "type": "Var",
                    "name": "ax"
                  },
                  "edge_type": "decomposes_into",
                  "any_type": false
                }
              }
            }
          }
        ]
      ]
    }
  ]
