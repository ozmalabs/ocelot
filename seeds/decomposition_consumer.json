{
  "id": "decomposition_consumer",
  "version": "1.0.0",
  "depends_on": [],
  "description": "Opt-in consumer for Impasse -needs_decomposition-> CapabilityAxis edges minted by order3_reframe. Partitions a multi-key parent axis across its requires_key CapKeys into distinct subskill child axes and tracks their mean saturation.",
  "microtheory": {
    "name": "decomposition_consumer",
    "description": "Partition an order-3 reframed CapabilityAxis into one subskill child axis per required CapKey without duplicating the parent's capability_keys."
  },
  "nodes": [
    {
      "local_id": 0,
      "type": "DecompositionConsumerPolicy",
      "attrs": {
        "enabled": 0.0,
        "child_shortfall": 0.6
      }
    }
  ],
  "edges": [
    {
      "src": {
        "role": "agent_root"
      },
      "type": "has_decomposition_consumer_policy",
      "tgt": {
        "local": 0
      },
      "attrs": {}
    }
  ],
  "productions": [
    {
      "provenance": "seed:decomposition_consumer:has_decomposition_consumer_policy",
      "src": {
        "type": "Agent",
        "var": "src"
      },
      "edge_type": "has_decomposition_consumer_policy",
      "tgt": {
        "type": "DecompositionConsumerPolicy",
        "var": "tgt"
      }
    },
    {
      "provenance": "seed:decomposition_consumer:needs_decomposition",
      "src": {
        "type": "Impasse",
        "var": "src"
      },
      "edge_type": "needs_decomposition",
      "tgt": {
        "type": "CapabilityAxis",
        "var": "tgt"
      }
    },
    {
      "provenance": "seed:decomposition_consumer:requires_key",
      "src": {
        "type": "CapabilityAxis",
        "var": "src"
      },
      "edge_type": "requires_key",
      "tgt": {
        "type": "CapKey",
        "var": "tgt"
      }
    },
    {
      "provenance": "seed:decomposition_consumer:decomposes_into",
      "src": {
        "type": "CapabilityAxis",
        "var": "src"
      },
      "edge_type": "decomposes_into",
      "tgt": {
        "type": "CapabilityAxis",
        "var": "tgt"
      }
    },
    {
      "provenance": "seed:decomposition_consumer:investigated_by",
      "src": {
        "type": "CapabilityAxis",
        "var": "src"
      },
      "edge_type": "investigated_by",
      "tgt": {
        "type": "Operator",
        "var": "tgt"
      }
    }
  ],
  "rules": [
    {
      "name": "dc_mint_child_per_key",
      "batch": false,
      "comment": "Partition a multi-key CapabilityAxis under needs_decomposition into one subskill child axis per required CapKey, each with distinct capability_keys.",
      "match": [
        [
          "agent",
          "has_decomposition_consumer_policy",
          "pol"
        ],
        [
          "mi",
          "needs_decomposition",
          "ax"
        ],
        [
          "ax",
          "requires_key",
          "k"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Eq",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "pol"
                  },
                  "key": "enabled"
                },
                {
                  "type": "Lit",
                  "value": 0
                }
              ]
            },
            "b": {
              "type": "Lit",
              "value": 1
            }
          },
          {
            "type": "Not",
            "arg": {
              "type": "Eq",
              "a": {
                "type": "Plus",
                "items": [
                  {
                    "type": "Attr",
                    "node": {
                      "type": "Var",
                      "name": "mi"
                    },
                    "key": "dc_handled"
                  },
                  {
                    "type": "Lit",
                    "value": 0
                  }
                ]
              },
              "b": {
                "type": "Lit",
                "value": 1
              }
            }
          },
          {
            "type": "Gt",
            "a": {
              "type": "Count",
              "source": {
                "type": "Neighbours",
                "node": {
                  "type": "Var",
                  "name": "ax"
                },
                "edge_type": "requires_key",
                "any_type": false
              }
            },
            "b": {
              "type": "Lit",
              "value": 1
            }
          },
          {
            "type": "Not",
            "arg": {
              "type": "Exists",
              "source": {
                "type": "Neighbours",
                "node": {
                  "type": "Var",
                  "name": "ax"
                },
                "edge_type": "decomposes_into",
                "any_type": false
              },
              "var_name": "c",
              "predicate": {
                "type": "Eq",
                "a": {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "c"
                  },
                  "key": "decomposed_key"
                },
                "b": {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "k"
                  },
                  "key": "name"
                }
              }
            }
          }
        ]
      },
      "effects": [
        [
          "add_node",
          "child",
          "CapabilityAxis",
          {
            "is_axis": 1.0,
            "subskill": 1.0,
            "saturation": 0.0,
            "shortfall": {
              "__term__": {
                "type": "Attr",
                "node": {
                  "type": "Var",
                  "name": "pol"
                },
                "key": "child_shortfall"
              }
            },
            "mf_stall": 0,
            "decomposed_key": {
              "__term__": {
                "type": "Attr",
                "node": {
                  "type": "Var",
                  "name": "k"
                },
                "key": "name"
              }
            },
            "parent_axis_ref": {
              "__term__": {
                "type": "Var",
                "name": "ax"
              }
            },
            "capability_keys": {
              "__term__": {
                "type": "Vec",
                "items": [
                  {
                    "type": "Attr",
                    "node": {
                      "type": "Var",
                      "name": "k"
                    },
                    "key": "name"
                  }
                ]
              }
            }
          }
        ],
        [
          "add_edge",
          "ax",
          "decomposes_into",
          "child"
        ],
        [
          "add_edge",
          "child",
          "requires_key",
          "k"
        ]
      ]
    },
    {
      "name": "dc_inherit_operator",
      "batch": false,
      "comment": "Bind newly partitioned subskill child axes to the parent axis's current operator when present.",
      "match": [
        [
          "agent",
          "has_decomposition_consumer_policy",
          "pol"
        ],
        [
          "ax",
          "decomposes_into",
          "child"
        ],
        [
          "ax",
          "investigated_by",
          "op"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Eq",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "pol"
                  },
                  "key": "enabled"
                },
                {
                  "type": "Lit",
                  "value": 0
                }
              ]
            },
            "b": {
              "type": "Lit",
              "value": 1
            }
          },
          {
            "type": "Eq",
            "a": {
              "type": "Count",
              "source": {
                "type": "Neighbours",
                "node": {
                  "type": "Var",
                  "name": "child"
                },
                "edge_type": "investigated_by",
                "any_type": false
              }
            },
            "b": {
              "type": "Lit",
              "value": 0
            }
          }
        ]
      },
      "effects": [
        [
          "add_edge",
          "child",
          "investigated_by",
          "op"
        ]
      ]
    },
    {
      "name": "dc_mark_handled",
      "batch": false,
      "comment": "Record partitioned outcome once every required CapKey of the parent axis has a child axis.",
      "match": [
        [
          "agent",
          "has_decomposition_consumer_policy",
          "pol"
        ],
        [
          "mi",
          "needs_decomposition",
          "ax"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Eq",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "pol"
                  },
                  "key": "enabled"
                },
                {
                  "type": "Lit",
                  "value": 0
                }
              ]
            },
            "b": {
              "type": "Lit",
              "value": 1
            }
          },
          {
            "type": "Not",
            "arg": {
              "type": "Eq",
              "a": {
                "type": "Plus",
                "items": [
                  {
                    "type": "Attr",
                    "node": {
                      "type": "Var",
                      "name": "mi"
                    },
                    "key": "dc_handled"
                  },
                  {
                    "type": "Lit",
                    "value": 0
                  }
                ]
              },
              "b": {
                "type": "Lit",
                "value": 1
              }
            }
          },
          {
            "type": "Gt",
            "a": {
              "type": "Count",
              "source": {
                "type": "Neighbours",
                "node": {
                  "type": "Var",
                  "name": "ax"
                },
                "edge_type": "requires_key",
                "any_type": false
              }
            },
            "b": {
              "type": "Lit",
              "value": 1
            }
          },
          {
            "type": "Not",
            "arg": {
              "type": "Exists",
              "source": {
                "type": "Neighbours",
                "node": {
                  "type": "Var",
                  "name": "ax"
                },
                "edge_type": "requires_key",
                "any_type": false
              },
              "var_name": "k",
              "predicate": {
                "type": "Not",
                "arg": {
                  "type": "Exists",
                  "source": {
                    "type": "Neighbours",
                    "node": {
                      "type": "Var",
                      "name": "ax"
                    },
                    "edge_type": "decomposes_into",
                    "any_type": false
                  },
                  "var_name": "c",
                  "predicate": {
                    "type": "Eq",
                    "a": {
                      "type": "Attr",
                      "node": {
                        "type": "Var",
                        "name": "c"
                      },
                      "key": "decomposed_key"
                    },
                    "b": {
                      "type": "Attr",
                      "node": {
                        "type": "Var",
                        "name": "k"
                      },
                      "key": "name"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "effects": [
        [
          "set_attr",
          "mi",
          "dc_handled",
          1
        ],
        [
          "set_attr",
          "mi",
          "dc_outcome",
          "partitioned"
        ]
      ]
    },
    {
      "name": "dc_no_partition",
      "batch": false,
      "comment": "Record honest no_partition outcome when the axis has at most one CapKey to decompose.",
      "match": [
        [
          "agent",
          "has_decomposition_consumer_policy",
          "pol"
        ],
        [
          "mi",
          "needs_decomposition",
          "ax"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Eq",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "pol"
                  },
                  "key": "enabled"
                },
                {
                  "type": "Lit",
                  "value": 0
                }
              ]
            },
            "b": {
              "type": "Lit",
              "value": 1
            }
          },
          {
            "type": "Not",
            "arg": {
              "type": "Eq",
              "a": {
                "type": "Plus",
                "items": [
                  {
                    "type": "Attr",
                    "node": {
                      "type": "Var",
                      "name": "mi"
                    },
                    "key": "dc_handled"
                  },
                  {
                    "type": "Lit",
                    "value": 0
                  }
                ]
              },
              "b": {
                "type": "Lit",
                "value": 1
              }
            }
          },
          {
            "type": "Lte",
            "a": {
              "type": "Count",
              "source": {
                "type": "Neighbours",
                "node": {
                  "type": "Var",
                  "name": "ax"
                },
                "edge_type": "requires_key",
                "any_type": false
              }
            },
            "b": {
              "type": "Lit",
              "value": 1
            }
          }
        ]
      },
      "effects": [
        [
          "set_attr",
          "mi",
          "dc_handled",
          1
        ],
        [
          "set_attr",
          "mi",
          "dc_outcome",
          "no_partition"
        ]
      ]
    },
    {
      "name": "dc_parent_progress_from_children",
      "batch": false,
      "comment": "Aggregate child axis saturations into child_mean_saturation on the parent axis.",
      "match": [
        [
          "agent",
          "has_decomposition_consumer_policy",
          "pol"
        ],
        [
          "ax",
          "decomposes_into",
          "child"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Eq",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "pol"
                  },
                  "key": "enabled"
                },
                {
                  "type": "Lit",
                  "value": 0
                }
              ]
            },
            "b": {
              "type": "Lit",
              "value": 1
            }
          },
          {
            "type": "Gt",
            "a": {
              "type": "Count",
              "source": {
                "type": "Neighbours",
                "node": {
                  "type": "Var",
                  "name": "ax"
                },
                "edge_type": "decomposes_into",
                "any_type": false
              }
            },
            "b": {
              "type": "Lit",
              "value": 0
            }
          },
          {
            "type": "Not",
            "arg": {
              "type": "Eq",
              "a": {
                "type": "Attr",
                "node": {
                  "type": "Var",
                  "name": "ax"
                },
                "key": "child_mean_saturation"
              },
              "b": {
                "type": "Div",
                "a": {
                  "type": "Sum",
                  "source": {
                    "type": "Neighbours",
                    "node": {
                      "type": "Var",
                      "name": "ax"
                    },
                    "edge_type": "decomposes_into",
                    "any_type": false
                  },
                  "var_name": "c",
                  "value": {
                    "type": "Plus",
                    "items": [
                      {
                        "type": "Attr",
                        "node": {
                          "type": "Var",
                          "name": "c"
                        },
                        "key": "saturation"
                      },
                      {
                        "type": "Lit",
                        "value": 0.0
                      }
                    ]
                  }
                },
                "b": {
                  "type": "Count",
                  "source": {
                    "type": "Neighbours",
                    "node": {
                      "type": "Var",
                      "name": "ax"
                    },
                    "edge_type": "decomposes_into",
                    "any_type": false
                  }
                }
              }
            }
          }
        ]
      },
      "effects": [
        [
          "set_attr",
          "ax",
          "child_mean_saturation",
          {
            "__term__": {
              "type": "Div",
              "a": {
                "type": "Sum",
                "source": {
                  "type": "Neighbours",
                  "node": {
                    "type": "Var",
                    "name": "ax"
                  },
                  "edge_type": "decomposes_into",
                  "any_type": false
                },
                "var_name": "c",
                "value": {
                  "type": "Plus",
                  "items": [
                    {
                      "type": "Attr",
                      "node": {
                        "type": "Var",
