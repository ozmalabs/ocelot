    "items": [
     {
      "type": "Eq",
      "a": {
       "type": "TypeOf",
       "node": {
        "type": "Var",
        "name": "t"
       }
      },
      "b": {
       "type": "Lit",
       "value": "Topic"
      }
     },
     {
      "type": "Eq",
      "a": {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "t"
       },
       "key": "name"
      },
      "b": {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "ct"
       },
       "key": "name"
      }
     },
     {
      "type": "Not",
      "arg": {
       "type": "Eq",
       "a": {
        "type": "Attr",
        "node": {
         "type": "Var",
         "name": "m"
        },
        "key": "comprehended"
       },
       "b": {
        "type": "Lit",
        "value": 1.0
       }
      }
     },
     {
      "type": "Not",
      "arg": {
       "type": "Eq",
       "a": {
        "type": "Attr",
        "node": {
         "type": "Var",
         "name": "c"
        },
        "key": "served"
       },
       "b": {
        "type": "Lit",
        "value": 1.0
       }
      }
     },
     {
      "type": "Exists",
      "source": {
       "type": "Neighbours",
       "node": {
        "type": "Var",
        "name": "m"
       },
       "edge_type": "has_mention"
      },
      "var_name": "mn",
      "predicate": {
       "type": "In",
       "member": {
        "type": "Attr",
        "node": {
         "type": "Var",
         "name": "mn"
        },
        "key": "text"
       },
       "container": {
        "type": "Lit",
        "value": [
         "more",
         "elaborate",
         "continue",
         "further",
         "else",
         "expand"
        ]
       }
      }
     },
     {
      "type": "Or",
      "items": [
       {
        "type": "Not",
        "arg": {
         "type": "Exists",
         "source": {
          "type": "InNeighbours",
          "node": {
           "type": "Var",
           "name": "c"
          },
          "edge_type": "next_detail"
         },
         "var_name": "p0",
         "predicate": {
          "type": "Lit",
          "value": true
         }
        }
       },
       {
        "type": "Exists",
        "source": {
         "type": "InNeighbours",
         "node": {
          "type": "Var",
          "name": "c"
         },
         "edge_type": "next_detail"
        },
        "var_name": "p",
        "predicate": {
         "type": "Eq",
         "a": {
          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "p"
          },
          "key": "served"
         },
         "b": {
          "type": "Lit",
          "value": 1.0
         }
        }
       }
      ]
     }
    ]
   },
   "effects": [
    [
     "set_attr",
     "c",
     "served",
     1.0
    ],
    [
     "set_attr",
     "m",
     "comprehended",
     1.0
    ],
    [
     "add_node",
     "reply",
     "Message",
     {
      "from": "agent",
      "text": {
       "__term__": {
        "type": "Attr",
        "node": {
         "type": "Var",
         "name": "c"
        },
        "key": "text"
       }
      }
     }
    ],
    [
     "add_edge",
     "reply",
     "responds_to",
     "m"
    ],
    [
     "add_edge",
     "agent",
     "sent",
     "reply"
    ]
   ]
  },
  {
   "name": "elaboration_exhausted",
   "match": [
