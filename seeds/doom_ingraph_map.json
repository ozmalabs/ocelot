         {
          "type": "Eq",
          "a": {
           "type": "IndexAt",
           "seq": {
            "type": "Attr",
            "node": {
             "type": "Var",
             "name": "C2"
            },
            "key": "pose"
           },
           "index": {
            "type": "Lit",
            "value": 1
           }
          },
          "b": {
           "type": "IndexAt",
           "seq": {
            "type": "Attr",
            "node": {
             "type": "Var",
             "name": "O"
            },
            "key": "pose"
           },
           "index": {
            "type": "Lit",
            "value": 1
           }
          }
         }
        ]
       }
      }
     }
    ]
   },
   "effects": [
    [
     "add_node",
     "C",
     "Cell",
     {
      "world_type": "Cell",
      "pose": {
       "__term__": {
        "type": "Attr",
