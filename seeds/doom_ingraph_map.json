{
 "id": "doom_ingraph_map",
 "version": "1.0.0",
 "depends_on": [],
 "description": "The persistent, GRAPH-NATIVE in-graph spatial map the agent accumulates while it explores (Doom, block 161000-161999). Composes the EXISTING Rust space_quantize primitive (has_cell belief -> SpaceQuantum passable/frontier boxes) with NEW seed rules that (1) GROW the persistent occupancy belief from the agent's own senses (pose/self-motion = walk-free; depth range-vision = depth_free/depth_wall) \u2014 unknown = ABSENCE, first-class; the merge POLICY (walk-free authoritative) is the dm_walk_frees_wall rule, never Python; and (2) TYPE each decoded area with a human region_kind (room/corridor/area/frontier) that falls out of the box's geometry relative to the agent's body width (config-space; no magic number). All rules guard on game.map_mode==\"doom\" -> INERT for every existing world (coarse path byte-identical). The ingest (pose/depth -> ObsCell world points) and the PNG display are mechanical world-adapter I/O (domains/doom_map_ingest.py); every ACCUMULATION and TYPING decision is a rule here.",
 "microtheory": {
  "name": "doom_ingraph_map",
  "description": "persistent graph-native spatial map: grow occupancy from senses, type areas by geometry"
 },
 "nodes": [],
 "edges": [],
 "productions": [],
 "concepts": [],
 "rules": [
  {
   "name": "dm_free_new",
   "comment": "GROW: an observed FREE cell (src=walk \u2014 first-hand occupancy \u2014 or src=depth_free \u2014 line-of-sight before a wall) whose pose is not yet a known has_cell Cell mints one (value 0). Registering an as-yet-unseen pose IS the explored region growing; a pose with no Cell stays absent = unknown (M3).",
   "match": [
    [
     "game",
     "observed",
     "O"
    ]
   ],
   "where": {
    "type": "And",
    "items": [
     {
      "type": "Eq",
      "a": {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "game"
       },
       "key": "map_mode"
      },
      "b": {
       "type": "Lit",
       "value": "doom"
      }
     },
     {
      "type": "Or",
      "items": [
       {
        "type": "Eq",
        "a": {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "O"
         },
         "key": "src"
        },
        "b": {
         "type": "Lit",
         "value": "walk"
        }
       },
       {
        "type": "Eq",
        "a": {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "O"
         },
         "key": "src"
        },
        "b": {
         "type": "Lit",
         "value": "depth_free"
        }
       }
      ]
     },
     {
      "type": "Not",
      "arg": {
       "type": "Exists",
       "source": {
        "type": "Neighbours",
        "node": {
         "type": "Var",
         "name": "game"
        },
        "edge_type": "has_cell",
        "any_type": false
       },
       "var_name": "C2",
       "predicate": {
        "type": "And",
        "items": [
         {
          "type": "Eq",
          "a": {
           "type": "IndexAt",
           "seq": {
            "type": "Attr",
            "node": {
             "type": "Var",
             "name": "C2"
            },
            "key": "pose"
           },
           "index": {
            "type": "Lit",
            "value": 0
           }
          },
          "b": {
           "type": "IndexAt",
