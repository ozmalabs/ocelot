      }}
     }
    ],
    [
     "add_edge",
     "retina",
     "has_vision_polygon",
     "polygon"
    ],
    [
     "set_attr",
     "column",
     "carve_epoch",
     {"__term__": {"type": "Attr", "node": {"type": "Var", "name": "task"}, "key": "input_epoch"}}
    ]
   ]
  }
 ]
