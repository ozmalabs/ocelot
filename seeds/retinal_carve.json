{
 "id": "retinal_carve",
 "version": "1.0.0",
 "self_load_only": true,
 "depends_on": [
  "retinal_onset"
 ],
 "area": "retina",
 "description": "Async common-fate carve (Rung 3 of the photon-eye migration). Objects are CARVED from the ASYNCHRONOUS onset-event stream (RetinalOnsetEvent, Rung 1) by COMMON FATE: contiguous retinal columns whose events share ONE coherent motion (one shared velocity Dc/De) group into a VisionPolygon azimuth span; columns carrying a DIFFERENT common-fate motion form a DIFFERENT polygon; a static/incoherent field carves nothing. This is the event-native replacement for the raster carve (native.segment on the coarse retinal_field) -- no raster, no frame diff, the SAME input Rung 2 reads. The `retinal_common_fate_carve` Rust task kind segments the sorted firing columns into maximal common-fate runs and fits each run's motion, emitting a fixed per-column stride-7 layout [is_group_start, col_min, col_max, direction, speed, coherence, n_events] with each run's block written at its START column's index. This rule matches every RetinalColumn against the done carve task and mints ONE VisionPolygon per run (anchored at the run's start column) when coherence and n_events exceed thresholds held as DATA on a RetinaCarveParams node, once per column-epoch via a carve_epoch guard. HONEST SCOPE: 1-D (an azimuth strip); a true 2-D carve needs the retina extended to elevation columns -- a named follow-on. OFF by default: the rule cannot fire unless a RetinaCarveParams node exists (created by the adapter only when context['visual_carve'] is set), and the adapter creates the carve task only then.",
 "microtheory": {
  "name": "retinal_carve",
  "description": "common-fate grouping of onset events across columns -> VisionPolygon azimuth spans"
 },
 "nodes": [],
 "edges": [],
 "productions": [
  {
   "provenance": "seed:retinal_carve:retina-carve-params",
   "src": {
    "type": "Retina",
    "var": "retina"
   },
   "edge_type": "has_carve_params",
   "tgt": {
    "type": "RetinaCarveParams",
    "var": "cparams"
   }
  },
  {
   "provenance": "seed:retinal_carve:retina-carve-task",
   "src": {
    "type": "Retina",
    "var": "retina"
   },
   "edge_type": "has_carve_task",
   "tgt": {
    "type": "CognitiveTask",
    "var": "task"
   }
  },
  {
   "provenance": "seed:retinal_carve:retina-vision-polygon",
   "src": {
    "type": "Retina",
    "var": "retina"
   },
   "edge_type": "has_vision_polygon",
