       "seq": {"type": "Attr", "node": {"type": "Var", "name": "task"}, "key": "output"},
       "index": {"type": "Plus", "items": [
        {"type": "Times", "items": [
         {"type": "Attr", "node": {"type": "Var", "name": "column"}, "key": "index"},
         {"type": "Lit", "value": 7}
        ]},
        {"type": "Lit", "value": 2}
       ]}
      }},
      "direction": {"__term__": {
       "type": "IndexAt",
       "seq": {"type": "Attr", "node": {"type": "Var", "name": "task"}, "key": "output"},
       "index": {"type": "Plus", "items": [
        {"type": "Times", "items": [
         {"type": "Attr", "node": {"type": "Var", "name": "column"}, "key": "index"},
         {"type": "Lit", "value": 7}
        ]},
        {"type": "Lit", "value": 3}
       ]}
      }},
      "speed": {"__term__": {
       "type": "IndexAt",
       "seq": {"type": "Attr", "node": {"type": "Var", "name": "task"}, "key": "output"},
       "index": {"type": "Plus", "items": [
        {"type": "Times", "items": [
         {"type": "Attr", "node": {"type": "Var", "name": "column"}, "key": "index"},
         {"type": "Lit", "value": 7}
        ]},
        {"type": "Lit", "value": 4}
       ]}
      }},
      "coherence": {"__term__": {
