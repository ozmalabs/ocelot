      "a": {
       "type": "IndexAt",
       "seq": {"type": "Attr", "node": {"type": "Var", "name": "task"}, "key": "output"},
       "index": {
        "type": "Plus",
        "items": [
         {"type": "Times", "items": [
          {"type": "Attr", "node": {"type": "Var", "name": "column"}, "key": "index"},
          {"type": "Lit", "value": 7}
         ]},
         {"type": "Lit", "value": 6}
        ]
       }
      },
      "b": {"type": "Attr", "node": {"type": "Var", "name": "cparams"}, "key": "min_events"}
     }
    ]
   },
   "effects": [
