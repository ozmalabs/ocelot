 "rules": [
  {
   "name": "retinal_mint_carve",
   "area": "retina",
   "order": 4,
   "latency_class": "hard_realtime",
   "match": [
    [
     "retina",
     "has_carve_params",
     "cparams"
    ],
    [
     "retina",
     "has_column",
     "column"
    ],
    [
     "retina",
     "has_carve_task",
     "task"
    ]
   ],
   "where": {
    "type": "And",
    "items": [
     {
      "type": "Eq",
      "a": {"type": "Attr", "node": {"type": "Var", "name": "task"}, "key": "kind"},
      "b": {"type": "Lit", "value": "retinal_common_fate_carve"}
     },
     {
      "type": "Eq",
      "a": {"type": "Attr", "node": {"type": "Var", "name": "task"}, "key": "status"},
      "b": {"type": "Lit", "value": "done"}
     },
     {
      "type": "Not",
      "arg": {
       "type": "Eq",
       "a": {"type": "Attr", "node": {"type": "Var", "name": "column"}, "key": "carve_epoch"},
       "b": {"type": "Attr", "node": {"type": "Var", "name": "task"}, "key": "input_epoch"}
      }
     },
     {
      "type": "Eq",
      "a": {
       "type": "IndexAt",
       "seq": {"type": "Attr", "node": {"type": "Var", "name": "task"}, "key": "output"},
       "index": {
        "type": "Plus",
        "items": [
         {"type": "Times", "items": [
          {"type": "Attr", "node": {"type": "Var", "name": "column"}, "key": "index"},
          {"type": "Lit", "value": 7}
         ]},
         {"type": "Lit", "value": 0}
        ]
       }
      },
      "b": {"type": "Lit", "value": 1.0}
     },
     {
      "type": "Gt",
      "a": {
       "type": "IndexAt",
       "seq": {"type": "Attr", "node": {"type": "Var", "name": "task"}, "key": "output"},
       "index": {
        "type": "Plus",
        "items": [
         {"type": "Times", "items": [
          {"type": "Attr", "node": {"type": "Var", "name": "column"}, "key": "index"},
          {"type": "Lit", "value": 7}
         ]},
         {"type": "Lit", "value": 5}
        ]
       }
      },
      "b": {"type": "Attr", "node": {"type": "Var", "name": "cparams"}, "key": "min_coherence"}
     },
     {
