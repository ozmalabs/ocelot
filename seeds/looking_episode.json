{
 "id": "looking_episode",
 "version": "1.0.0",
 "self_load_only": true,
 "depends_on": [
  "surface_persistence"
 ],
 "latency_class": "hard_realtime",
 "description": "Mary's Room stage 4.5 (seed 4): LOOKING EPISODES, kept apart from colour properties. Per exposure (Retina.input_epoch advance) ONE durable LookingEpisode{epoch, status 'observed'}: Retina -had_episode-> episode -observed_by-> Observer (a seed-declared node, agent_root -has_observer->). Per PersistentSurface matched that epoch, a SurfaceLook{epoch, sid, rg, by, intensity, n_cells} = mean over member cells of the RetinalPercept red_green / blue_yellow / intensity (opponent ACTIVATIONS: adaptation changes the look), episode -includes_look-> look -look_of-> surface. An exposure with no boundary segment (ganzfeld, eyelid) gets ONE FieldLook (whole-field mean) and no SurfaceLook. Provenance: status attr only (episodic_working_memory_core not reused: it brings its own policies and gates). Flag LookingEpisodeParams.enabled, OFF by default (sec 9). See tools/build_looking_episode_seed.py.",
 "microtheory": {
  "name": "looking_episode",
  "description": "exposures -> looking episodes with per-surface looks"
 },
 "nodes": [
  {
   "local_id": 0,
   "type": "LookingEpisodeParams",
   "attrs": {
    "enabled": 0.0
   }
  },
  {
   "local_id": 1,
   "type": "LookingState",
   "attrs": {
    "last_epoch": -1
   }
  },
  {
   "local_id": 2,
   "type": "Observer",
   "attrs": {
    "role": "observer"
   }
  }
 ],
 "edges": [
  {
   "src": {
    "role": "agent_root"
   },
   "type": "has_looking_episode_params",
   "tgt": {
    "local": 0
   },
   "attrs": {}
  },
  {
   "src": {
    "local": 0
   },
   "type": "has_looking_state",
   "tgt": {
    "local": 1
   },
   "attrs": {}
  },
  {
   "src": {
    "role": "agent_root"
   },
   "type": "has_observer",
   "tgt": {
    "local": 2
   },
   "attrs": {}
  }
 ],
 "productions": [],
 "rules": [
  {
   "name": "le_mint",
   "comment": "One durable LookingEpisode per exposure: when the Retina's input_epoch passes LookingState.last_epoch. Bound once per retina through its first column (cell_index 0, a position, not a tuned value). Epoch 0 is the eye's pre-exposure clock.",
   "match": [
    [
     "lep",
     "has_looking_state",
     "ls"
    ],
    [
     "agent",
     "has_observer",
     "ob"
    ],
    [
     "retina",
     "has_column",
     "c0"
    ]
   ],
   "where": {
    "type": "And",
    "items": [
     {
      "type": "Gt",
      "a": {
       "type": "MaxOver",
       "source": {
        "type": "NodesOfType",
        "node_type": "LookingEpisodeParams"
       },
       "var_name": "lep_",
       "value": {
        "type": "Attr",
        "node": {
         "type": "Var",
         "name": "lep_"
        },
        "key": "enabled"
       },
       "default": {
        "type": "Lit",
        "value": 0.0
       }
      },
      "b": {
       "type": "Lit",
       "value": 0.5
      }
     },
     {
      "type": "Eq",
      "a": {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "c0"
       },
       "key": "cell_index"
      },
      "b": {
       "type": "Lit",
       "value": 0
      }
     },
     {
      "type": "Gt",
      "a": {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "retina"
       },
       "key": "input_epoch"
      },
      "b": {
       "type": "Lit",
       "value": 0
      }
     },
     {
      "type": "Gt",
      "a": {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "retina"
       },
       "key": "input_epoch"
      },
      "b": {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "ls"
       },
       "key": "last_epoch"
      }
     }
    ]
   },
   "effects": [
    [
     "add_node",
     "E",
     "LookingEpisode",
     {
      "epoch": {
       "__term__": {
        "type": "Attr",
        "node": {
         "type": "Var",
         "name": "retina"
        },
        "key": "input_epoch"
       }
      },
      "status": {
       "__term__": {
        "type": "Lit",
        "value": "observed"
       }
      }
     }
    ],
    [
     "add_edge",
     "retina",
     "had_episode",
     "E"
    ],
    [
     "add_edge",
     "E",
     "observed_by",
     "ob"
    ],
    [
     "add_edge",
     "ls",
     "current_episode",
     "E"
    ],
    [
     "set_attr",
     "ls",
     "last_epoch",
     {
      "__term__": {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "retina"
       },
       "key": "input_epoch"
      }
     }
    ]
   ]
  },
  {
   "name": "le_retire",
   "comment": "Drop the live current_episode pointer to an older episode (the episode itself is durable).",
   "match": [
    [
     "ls",
     "current_episode",
     "E"
    ]
   ],
   "where": {
    "type": "And",
    "items": [
     {
      "type": "Gt",
      "a": {
       "type": "MaxOver",
       "source": {
        "type": "NodesOfType",
        "node_type": "LookingEpisodeParams"
       },
       "var_name": "lep_",
       "value": {
        "type": "Attr",
        "node": {
         "type": "Var",
         "name": "lep_"
        },
        "key": "enabled"
       },
       "default": {
        "type": "Lit",
        "value": 0.0
       }
      },
      "b": {
       "type": "Lit",
       "value": 0.5
      }
     },
     {
      "type": "Lt",
      "a": {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "E"
       },
       "key": "epoch"
      },
      "b": {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "ls"
       },
       "key": "last_epoch"
      }
     }
    ]
   },
   "effects": [
    [
     "del_edge",
     "ls",
     "current_episode",
     "E"
    ]
   ]
  },
  {
