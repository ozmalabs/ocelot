      "arg": {
       "type": "Exists",
       "source": {
        "type": "InNeighbours",
        "node": {
         "type": "Var",
         "name": "S"
        },
        "edge_type": "in_segment",
        "any_type": false
       },
       "var_name": "m_",
       "predicate": {
        "type": "Not",
        "arg": {
         "type": "Eq",
         "a": {
          "type": "Attr",
          "node": {
           "type": "PickUnique",
           "source": {
            "type": "Neighbours",
            "node": {
