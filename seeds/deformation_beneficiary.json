    {
      "name": "db_goal_bearing",
      "comment": "THE PREREQUISITE. A frame is goal-bearing iff it holds a tube \u2014 a represented preference over its own continuations. That is the structural signature, not a node-type whitelist: the same `future_manifold_target` the audit reads and `feasible_selection` breaks ties on. Gravity holds no tube, which is the whole point.",
      "match": [
        [
          "f",
          "uses_policy",
          "pol"
        ]
      ],
      "where": {
        "type": "Not",
        "arg": {
          "type": "Eq",
          "a": {
            "type": "Attr",
            "node": {
              "type": "Var",
              "name": "f"
            },
            "key": "goal_bearing"
          },
          "b": {
            "type": "IfThenElse",
            "cond": {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "f"
              },
              "key": "future_manifold_target"
            },
            "then": {
              "type": "Lit",
              "value": 1.0
            },
            "other": {
              "type": "Lit",
              "value": 0.0
            }
          }
        }
      },
      "effects": [
        [
          "set_attr",
          "f",
          "goal_bearing",
          {
            "__term__": {
              "type": "IfThenElse",
              "cond": {
                "type": "Attr",
                "node": {
                  "type": "Var",
                  "name": "f"
                },
                "key": "future_manifold_target"
              },
              "then": {
                "type": "Lit",
                "value": 1.0
              },
              "other": {
                "type": "Lit",
                "value": 0.0
              }
            }
          }
        ]
      ]
    },
