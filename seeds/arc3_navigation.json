 "concepts": [
  {
   "name": "is_floor",
   "domain": "arc3_navigation",
   "definition": {
    "type": "Eq",
    "a": {
     "type": "Attr",
     "node": {
      "type": "Var",
      "name": "c"
     },
     "key": "floor"
    },
    "b": {
     "type": "Lit",
     "value": 1.0
    }
   },
   "comment": "a cell is floor iff figure/ground marked it ground (background_region) \u2014 the agent's perception, not a population count. (Placeholder attr form until region-grouping is graph-native; the design uses Holds(background_region).)"
  }
 ],
 "rules": [
  {
   "name": "max_region_count",
   "comment": "the floor is the LARGEST region; stash its count on the Game so mark_floor is O(cells) not O(cells*regions). [where reads count so precise-dirty re-wakes it after bounds]",
   "match": [
    [
     "game",
     "has_region",
     "any"
    ]
   ],
   "where": {
    "type": "Gte",
    "a": {
     "type": "Attr",
     "node": {
      "type": "Var",
      "name": "any"
     },
     "key": "count"
    },
    "b": {
     "type": "Lit",
     "value": 0
    }
   },
   "effects": [
    [
     "set_attr",
     "game",
     "max_region_count",
     {
      "__term__": {
       "type": "MaxOver",
       "source": {
        "type": "NodesOfType",
        "node_type": "Region"
       },
       "var_name": "r",
       "value": {
        "type": "Attr",
        "node": {
         "type": "Var",
         "name": "r"
        },
        "key": "count"
       },
       "default": {
        "type": "Lit",
        "value": 0
       }
      }
     }
    ]
   ]
  },
  {
   "name": "mark_floor_as_location",
   "comment": "a cell in the largest (floor) region becomes a SpatialLocation \u2014 is_floor via figure/ground size, no xmax/ymax needed. [persistent regions: floor = largest by count, no frame gate]",
