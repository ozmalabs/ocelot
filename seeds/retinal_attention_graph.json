          }
        ],
        [
          "set_attr",
          "agent",
          "attention_az",
          {
            "__term__": {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "candidate"
              },
              "key": "gaze_az"
            }
          }
        ],
        [
          "set_attr",
