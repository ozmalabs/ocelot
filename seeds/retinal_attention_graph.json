                "key": "residual_salience"
              },
              "b": {
                "type": "Max",
                "items": [
                  {
                    "type": "Lit",
                    "value": 1e-06
                  },
                  {
                    "type": "Div",
                    "a": {
                      "type": "Sum",
                      "source": {
                        "type": "Filter",
                        "source": {
                          "type": "Neighbours",
                          "node": {
                            "type": "Var",
                            "name": "resolver"
                          },
                          "edge_type": "has_candidate"
                        },
                        "var_name": "k",
                        "predicate": {
                          "type": "Eq",
                          "a": {
                            "type": "Attr",
                            "node": {
                              "type": "Var",
                              "name": "k"
                            },
                            "key": "candidate_epoch"
                          },
                          "b": {
                            "type": "Attr",
                            "node": {
                              "type": "Var",
                              "name": "agent"
                            },
                            "key": "vision_settled_epoch"
                          }
                        }
                      },
                      "var_name": "k",
                      "value": {
                        "type": "Attr",
                        "node": {
                          "type": "Var",
                          "name": "k"
                        },
                        "key": "residual_salience"
                      }
                    },
                    "b": {
                      "type": "Count",
                      "source": {
                        "type": "Filter",
                        "source": {
                          "type": "Neighbours",
                          "node": {
                            "type": "Var",
                            "name": "resolver"
                          },
                          "edge_type": "has_candidate"
                        },
                        "var_name": "k",
