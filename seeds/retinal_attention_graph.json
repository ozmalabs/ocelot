                        },
                        "key": "my_angle"
                      },
                      {
                        "type": "Lit",
                        "value": 0.017453292519943295
                      }
                    ]
                  },
                  {
                    "type": "Attr",
                    "node": {
                      "type": "Var",
                      "name": "candidate"
                    },
                    "key": "gaze_az"
                  }
                ]
              }
