      "type": "ThinkingBudget",
      "attrs": {
        "name": "core_thinking_budget",
        "enabled": 0.0,
        "capacity": 16.0,
        "capacity_ceiling": 64.0,
        "funding_gain": 2.0,
        "remaining": 16.0,
        "refill_per_epoch": 2.0,
        "last_refill_epoch": -1.0
      }
    }
