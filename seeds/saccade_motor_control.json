{
  "id": "saccade_motor_control",
  "version": "1.0.0",
  "depends_on": [
    "retinal_focus_control"
  ],
  "description": "Default-off graph-native saccade motor apparatus. A current uniquely resolved attention verdict becomes a PresaccadicCandidate. ArgminUnique over negative candidate priority emits at most one EyeMotorCommand; empty and exact-tied candidate sets remain an explicit refusal. The command carries a SaccadeEfferenceCopy and creates a presaccadic Fixation only when the existing retinal-focus command agrees exactly. The fixation is confirmed only by a later settled sensor epoch using that same focus target. Requested commands whose source epoch has already passed are rejected. No host decision, raw pixels, task-specific vocabulary, or world mutation.",
  "microtheory": {
    "name": "saccade_motor_control",
    "description": "presaccadic selection -> eye motor command + efference copy -> confirmed fixation"
  },
  "nodes": [
    {
      "local_id": 0,
      "type": "SaccadeController",
      "attrs": {
        "enabled": 0.0,
        "purpose": "graph_native_eye_motor_control",
        "current_column": 0,
        "current_row": 0,
        "duration_tics": 1
      }
    }
  ],
  "edges": [
    {
      "src": {"role": "agent_root"},
      "type": "has_saccade_controller",
      "tgt": {"local": 0},
      "attrs": {}
    }
  ],
  "productions": [
    {
      "provenance": "seed:saccade_motor_control:agent-controller",
      "src": {"type": "Agent", "var": "agent"},
      "edge_type": "has_saccade_controller",
      "tgt": {"type": "SaccadeController", "var": "controller"}
    },
    {
      "provenance": "seed:saccade_motor_control:controller-candidate",
      "src": {"type": "SaccadeController", "var": "controller"},
      "edge_type": "has_presaccadic_candidate",
      "tgt": {"type": "PresaccadicCandidate", "var": "candidate"}
    },
    {
      "provenance": "seed:saccade_motor_control:controller-command",
      "src": {"type": "SaccadeController", "var": "controller"},
      "edge_type": "has_eye_motor_command",
      "tgt": {"type": "EyeMotorCommand", "var": "command"}
    },
    {
      "provenance": "seed:saccade_motor_control:controller-decision",
      "src": {"type": "SaccadeController", "var": "controller"},
      "edge_type": "has_saccade_decision",
      "tgt": {"type": "SaccadeDecision", "var": "decision"}
    },
    {
      "provenance": "seed:saccade_motor_control:controller-fixation",
      "src": {"type": "SaccadeController", "var": "controller"},
      "edge_type": "has_fixation",
      "tgt": {"type": "Fixation", "var": "fixation"}
    },
    {
      "provenance": "seed:saccade_motor_control:agent-fixation",
      "src": {"type": "Agent", "var": "agent"},
      "edge_type": "has_fixation",
      "tgt": {"type": "Fixation", "var": "fixation"}
    },
