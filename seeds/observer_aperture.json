    {
      "name": "ap_decode_percept",
      "comment": "Decode the observer's QUOTIENT of what it sees against its QUOTIENT of what it holds. Projecting only the goal would decode a blurred observation against full-detail parts, which is nobody's situation. The covered/residual pair is the whole point: an observer can read a NON-EMPTY residual -- know that something here is not covered -- without being able to resolve what it is, because resolving it needs the very dimension the projection collapsed. Knowing THAT, without knowing WHAT (ONE_LOOP_MANY_GRAINS.md).",
      "match": [
        [
          "obs",
          "projected",
          "pv"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Not",
            "arg": {
              "type": "Eq",
              "a": {
                "type": "Attr",
                "node": {
                  "type": "Var",
                  "name": "pv"
                },
                "key": "ap_seen"
              },
              "b": {
                "type": "Attr",
                "node": {
                  "type": "Var",
                  "name": "obs"
                },
                "key": "ap_scope_n"
              }
            }
          },
          {
            "type": "Eq",
            "a": {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "pv"
              },
              "key": "ap_gen"
            },
            "b": {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "obs"
              },
              "key": "ap_gen"
            }
          }
        ]
      },
