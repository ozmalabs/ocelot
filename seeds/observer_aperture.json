              }
            },
            "name": {
              "__term__": {
                "type": "StringConcat",
                "parts": [
                  {
                    "type": "Attr",
                    "node": {
                      "type": "Var",
                      "name": "obs"
                    },
                    "key": "name"
                  },
                  {
                    "type": "Lit",
                    "value": "/"
                  },
                  {
                    "type": "ToJsonString",
                    "value": {
                      "type": "Attr",
