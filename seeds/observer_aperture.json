    {
      "name": "ap_refresh_scope",
      "comment": "APERTURE and RANGE compose. The quotient decides what an observer can TELL APART; the scope decides what it HOLDS. An observer's scope is exactly the set of its own projected parts, so a decode reads that observer's quotient of the world and nobody else's -- over the one shared store, no private copy per agent. Re-arms whenever the observer acquires another part.",
      "match": [
        [
          "obs",
          "projected_part",
          "pp"
        ]
      ],
      "where": {
        "type": "Not",
        "arg": {
          "type": "Eq",
          "a": {
            "type": "Attr",
            "node": {
              "type": "Var",
              "name": "obs"
            },
            "key": "ap_scope"
          },
          "b": {
            "type": "MapList",
            "source": {
              "type": "FilterList",
              "source": {
                "type": "Neighbours",
                "node": {
                  "type": "Var",
                  "name": "obs"
                },
                "edge_type": "projected_part"
              },
              "var_name": "q",
              "predicate": {
                "type": "Eq",
                "a": {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "q"
                  },
                  "key": "ap_gen"
                },
                "b": {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "obs"
                  },
                  "key": "ap_gen"
                }
              }
            },
            "var_name": "q",
            "value": {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "q"
              },
              "key": "name"
            }
          }
        }
      },
