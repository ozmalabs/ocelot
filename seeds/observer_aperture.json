                    "edge_type": "projected_part"
                  },
                  "var_name": "q",
                  "predicate": {
                    "type": "Eq",
                    "a": {
                      "type": "Attr",
                      "node": {
                        "type": "Var",
                        "name": "q"
                      },
                      "key": "ap_gen"
                    },
                    "b": {
                      "type": "Attr",
                      "node": {
                        "type": "Var",
                        "name": "obs"
                      },
                      "key": "ap_gen"
                    }
