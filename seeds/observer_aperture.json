{
  "id": "observer_aperture",
  "version": "1.2.0",
  "comment": "Emit seeds/observer_aperture.json -- per-observer APERTURE as graph data.\n\n`PER_OBSERVER_APERTURE.md` established RANGE (`codebook_scope`) is already\ngraph-native and per-observer, and that graded APERTURE is a QUOTIENT: project a\nsignature onto the dimensions the observer resolves, replacing unresolved slots\nwith a CONSTANT (not a wildcard -- WILD says \"anything filled this\", the quotient\nsays \"these are the same thing to me\"), then match literally.\n\nThe projection needs no new Rust. Every codebook already tags slots with\n`dim_types`, and MapList/ZipWith/In/IfThenElse compose the projection over it.\nThis seed makes that a rule an observer node drives, so no Python decides who\nsees what.\n\nBoth halves are projected. Projecting only the goal would decode an observer's\nblurred view against full-detail parts, which is nobody's situation.\n",
  "depends_on": [
    "core"
  ],
  "productions": [
    {
      "provenance": "seed:observer_aperture:perceives",
      "src": {
        "type": "Observer",
        "var": "obs"
      },
      "edge_type": "perceives",
      "tgt": {
        "type": "ShapeSignature",
        "var": "sh"
      }
    },
    {
      "provenance": "seed:observer_aperture:holds-part",
      "src": {
        "type": "Observer",
        "var": "obs"
      },
      "edge_type": "holds_part",
      "tgt": {
        "type": "ShapeSignature",
        "var": "sh"
      }
    },
    {
      "provenance": "seed:observer_aperture:projected",
      "src": {
        "type": "Observer",
        "var": "obs"
      },
      "edge_type": "projected",
      "tgt": {
        "type": "ObservedShape",
        "var": "pv"
      }
    },
    {
      "provenance": "seed:observer_aperture:projected-part",
      "src": {
        "type": "Observer",
        "var": "obs"
      },
      "edge_type": "projected_part",
      "tgt": {
        "type": "ObservedShape",
        "var": "pp"
      }
    }
  ],
  "rules": [
    {
      "name": "ap_project_percept",
      "comment": "An observer's view of a thing it perceives is its own QUOTIENT of that thing -- the slots it resolves kept, the rest collapsed to one constant. Per-call, over the SHARED store: many partial views of one world rather than a private world per agent.",
      "match": [
        [
          "obs",
          "perceives",
          "sh"
        ]
      ],
      "where": {
        "type": "Not",
        "arg": {
          "type": "Exists",
          "source": {
            "type": "Neighbours",
            "node": {
              "type": "Var",
              "name": "obs"
            },
            "edge_type": "projected"
          },
          "var_name": "p",
          "predicate": {
            "type": "And",
            "items": [
              {
                "type": "Eq",
                "a": {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "p"
                  },
                  "key": "of_name"
                },
                "b": {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "sh"
                  },
                  "key": "name"
                }
              },
              {
                "type": "Eq",
                "a": {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "p"
                  },
                  "key": "ap_gen"
                },
                "b": {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "obs"
                  },
                  "key": "ap_gen"
                }
              }
            ]
          }
        }
      },
      "effects": [
        [
          "add_node",
          "pv",
          "ObservedShape",
          {
            "ap_gen": {
              "__term__": {
                "type": "Attr",
                "node": {
                  "type": "Var",
                  "name": "obs"
                },
                "key": "ap_gen"
              }
            },
            "ap_seen": -1.0,
            "of_name": {
              "__term__": {
                "type": "Attr",
                "node": {
                  "type": "Var",
                  "name": "sh"
                },
                "key": "name"
              }
            },
            "observer": {
              "__term__": {
                "type": "Attr",
                "node": {
                  "type": "Var",
                  "name": "obs"
                },
                "key": "name"
              }
            },
            "kind": "percept",
            "signature": {
              "__term__": {
                "type": "MapList",
                "source": {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "sh"
                  },
                  "key": "signature"
                },
                "var_name": "rel",
                "value": {
                  "type": "ZipWith",
                  "a": {
                    "type": "Var",
                    "name": "rel"
                  },
                  "b": {
                    "type": "Attr",
                    "node": {
                      "type": "Var",
                      "name": "sh"
                    },
                    "key": "dim_types"
                  },
                  "a_name": "slot",
                  "b_name": "dt",
                  "value": {
                    "type": "IfThenElse",
                    "cond": {
                      "type": "In",
                      "member": {
                        "type": "Var",
                        "name": "dt"
                      },
                      "container": {
                        "type": "Attr",
                        "node": {
                          "type": "Var",
                          "name": "obs"
                        },
                        "key": "resolves"
                      }
                    },
                    "then": {
                      "type": "Var",
                      "name": "slot"
                    },
                    "other": {
                      "type": "Lit",
                      "value": "\u00b7"
                    }
                  }
                }
              }
            }
          }
        ],
        [
          "add_edge",
          "obs",
          "projected",
          "pv"
        ]
      ]
    },
    {
