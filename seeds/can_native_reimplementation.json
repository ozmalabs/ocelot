 "concepts": [
  {
   "name": "can_native_discrete_async_update",
   "definition": "Evidence propagation as a discrete, asynchronous, Hopfield-style threshold update over Concept.state, expressed as ordinary graph Rules (can_native_update_plus/minus/zero for the native 3-state vocabulary; _2state siblings for the classical 2-state Lyapunov-guaranteed comparison).",
   "why": "Replaces can_ops.rs's synchronous (even damped) mean-field relaxation for the propagation half of CAN -- see CAN_CONCEPT_REIMPLEMENTATION_SPIKE.md Sec3.4/Sec4.2 and this seed's RESULTS sibling for the live convergence comparison."
  },
  {
   "name": "can_native_basin_classification",
   "definition": "A held basin configuration is a ShapeSignature codebook entry (relation tuples ['state', concept, sign]); the CURRENT state is decoded via ShapeDecode, SCOPED to one candidate basin at a time (codebook_scope), against each held configuration independently. Full coverage (residual empty) against exactly one candidate = clean recognition; the covered_count read across all candidates is the distance-to-nearest-attractor / frustration reading.",
   "why": "Replaces can_ops.rs::audit_basin's single mean-field call + eyeballed report for the CLASSIFICATION half of basin/frustration (CAN_CONCEPT_REIMPLEMENTATION_SPIKE.md Sec3.1/Sec3.2). Basin ENUMERATION is explicitly NOT covered (per the spike's own Sec3.1/Sec6 finding: unexercised by anything this project has built)."
  },
  {
   "name": "can_native_hebbian_mint",
   "definition": "Persistent same-sign co-activation of two uncoupled Concepts, observed across >=2 distinct ticks (can_tick epoch-gated), mints ONE causal_influence edge -- mint-on-recurrence, the edge-CREATION half of Hebbian learning only.",
   "why": "Graded reweighting of an ALREADY-minted edge needs the logodds DimensionGenerator (CAUSAL_LINKAGE_DIMENSION_RESEARCH.md), confirmed still unbuilt this rung -- named as the blocker, not built. Decay has no native analog proposed."
  }
 ],
