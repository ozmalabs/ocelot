   "local_id": 0,
   "type": "UnansweredGapPolicy",
   "attrs": {
    "name": "unanswered_gap",
    "enabled": 1,
    "min_recurrence": 2,
    "description": "Agent-held policy: how many unanswered turns of one evidence class make a concern."
   }
  }
