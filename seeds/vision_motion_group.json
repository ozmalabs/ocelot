 "rules": [
  {
   "name": "mo_pair_diff",
   "comment": "THE FIELD'S OWN DISPERSION, READ AS VECTORS. `pd` is the largest disagreement between this cell's motion vector and any 4-neighbour's, computed by ONE `Magnitude(VecSub(n.v, R.v))` -- the engine's native vector difference, NOT a statistic reassembled from per-component scalar comparisons. The distribution of `pd` over the field is what the tolerance falls out of in `mo_tol_otsu`; it is measured in the SAME units as the pairwise difference the flood tests, so no scale is smuggled between deriving the tolerance and applying it.",
   "match_type": null,
   "match": [
    [
     "field",
     "has_cell",
     "R"
    ]
   ],
   "where": {
    "type": "And",
    "items": [
     {
      "type": "Gt",
