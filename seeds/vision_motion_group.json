       "type": "Attr",
       "key": "marm",
       "node": {
        "type": "PickUnique",
        "source": {
         "type": "NodesOfType",
         "node_type": "MotionParams"
        }
       }
      },
      "b": {
       "type": "Lit",
       "value": 0.5
      }
     },
     {
      "type": "Lt",
      "a": {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "R"
       },
       "key": "pd_done"
      },
      "b": {
       "type": "Lit",
       "value": 0.5
      }
     }
    ]
   },
   "effects": [
    [
     "set_attr",
     "R",
     "pd",
     {
      "__term__": {
       "type": "MaxOver",
       "source": {
        "type": "Neighbours",
