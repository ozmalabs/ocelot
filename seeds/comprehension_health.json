           "value": "\")"
          }
         ]
        }
       }
      }
     }
    ]
   },
   "effects": [
    [
     "set_attr",
     "m",
     "divergence_health_noted",
     1.0
    ],
    [
     "add_node",
     "sc",
     "SelfConcern",
     {
      "status": "noted",
      "source": "implicit",
      "kind": "comprehension",
      "content": {
       "__term__": {
        "type": "StringConcat",
        "parts": [
         {
          "type": "Lit",
          "value": "comprehension classified this as '"
         },
         {
          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "m"
          },
          "key": "comp_kind"
         },
         {
          "type": "Lit",
          "value": "' but the deep reader heard '"
         },
         {
          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "m"
          },
          "key": "shadow_speech_act"
         },
         {
          "type": "Lit",
          "value": "' (recurring; e.g. \""
         },
         {
          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "m"
          },
          "key": "text"
         },
         {
          "type": "Lit",
          "value": "\")"
         }
        ]
       }
      }
     }
    ],
    [
     "add_edge",
     "agent",
     "has_self_concern",
     "sc"
    ],
    [
     "add_edge",
     "sc",
     "about_message",
     "m"
    ]
   ]
  },
  {
   "name": "note_comprehension_latency_gap",
   "match": [
    [
     "agent",
     "received",
     "m"
    ]
   ],
   "where": {
    "type": "And",
    "items": [
     {
      "type": "Not",
      "arg": {
       "type": "Eq",
       "a": {
        "type": "Attr",
        "node": {
         "type": "Var",
         "name": "m"
        },
        "key": "shadow_seq"
       },
       "b": {
        "type": "Lit",
        "value": null
