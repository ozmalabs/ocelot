        "type": "Lit",
        "value": 1.0
       }
      }
     },
     {
      "type": "Gte",
      "a": {
       "type": "Count",
       "source": {
        "type": "Neighbours",
        "node": {
         "type": "Var",
         "name": "sh"
        },
        "edge_type": "has_member"
       }
      },
      "b": {
       "type": "Lit",
       "value": 3.0
      }
     },
     {
      "type": "Not",
      "arg": {
       "type": "Exists",
       "source": {
        "type": "NodesOfType",
        "node_type": "SelfConcern"
       },
       "var_name": "sc2",
       "predicate": {
        "type": "Eq",
        "a": {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "sc2"
         },
         "key": "content"
        },
        "b": {
