          }
         },
         "then": {
          "type": "Plus",
          "items": [
           {
            "type": "Attr",
            "node": {
             "type": "Var",
             "name": "R"
            },
            "key": "csal"
           },
           {
            "type": "Times",
            "items": [
             {
