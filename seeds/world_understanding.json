{
 "id": "world_understanding",
 "version": "1.0.0",
 "depends_on": [],
 "description": "The world-understanding interface (the creator's reframe: not a game-player, a world-understander pointed at a world). Hardcodes only the six universal ROLES; game is data. BIND mints a WorldBinding + six WorldRole slots on any recognised world; held faculties fill them; worlds nest (rollup_value/terminal_escalate/contain/reconcile); a backgrounded terminal is deduce-extrapolated (terminal_watch) and preempts a worker back (preempt_for_terminal). Frames (Game/Conversation) are priors over how a world-KIND fills the roles. Consumers (navigate_alive) + the parallel allocator are adapter methods over the held WorkerPool. Built+verified: world_roles/nesting/interrupt/conversation.",
 "microtheory": {
  "name": "world_understanding",
  "description": "six universal world-roles + frame library; bind any world, nest worlds, attend per-binding up to system backpressure"
 },
 "nodes": [
  {
   "local_id": 0,
   "type": "WorldFrame",
   "attrs": {
    "kind": "Game",
    "shape": "prediction_minus_observation",
    "fills_controllable_locus": "respond_votes",
    "fills_value_signal": "score",
    "fills_terminal": "death",
    "fills_goal": "positive_kind",
    "fills_affordance_effect": "action_delta",
    "fills_dynamics": "region_postulates"
   }
  },
  {
   "local_id": 1,
   "type": "WorldFrame",
   "attrs": {
    "kind": "Conversation",
    "shape": "dialogic_exchange",
    "fills_controllable_locus": "write_head",
    "fills_value_signal": "uptake_minus_repair",
    "fills_terminal": "breakdown",
    "fills_goal": "intent_satisfied",
    "fills_affordance_effect": "speech_acts",
    "fills_dynamics": "turn_taking_laws"
   }
  }
 ],
