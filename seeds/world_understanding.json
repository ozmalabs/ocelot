         "type": "Var",
         "name": "w"
        },
        "key": "world_type"
       },
       "b": {
        "type": "Lit",
        "value": ""
       }
      }
     },
     {
      "type": "Lt",
      "a": {
       "type": "Plus",
       "items": [
        {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "w"
         },
         "key": "has_binding"
        },
        {
         "type": "Lit",
         "value": 0.0
        }
       ]
      },
      "b": {
       "type": "Lit",
       "value": 0.5
      }
