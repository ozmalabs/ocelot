                  "type": "Var",
                  "name": "agent"
                },
                "key": "vision_settled_epoch"
              }
            }
          },
          {
            "type": "Not",
            "arg": {
              "type": "Eq",
              "a": {
                "type": "Attr",
                "node": {
                  "type": "Var",
                  "name": "agent"
                },
                "key": "held_attention_candidate_count"
              },
              "b": {
                "type": "Count",
