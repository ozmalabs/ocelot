{
  "id": "held_prediction_attention",
  "version": "1.0.0",
  "depends_on": [
    "retinal_attention_graph"
  ],
  "description": "Generic attention route for held-surface prediction error. Every mechanically projected HeldPredictionResidual enters a dedicated FoveaResolver in its native photon-count/luminance-quanta unit. The existing fovea_salience_bridge selects the unique greatest positive current-epoch residual and refuses exact ties. Only after selection is its magnitude normalized by the current held-residual sheet mean into a dimensionless contrast compatible with motor attention. The physical residual remains separately published as attention_prediction_residual_quanta and is never compared to retinal motion salience in cells/epoch. The held route supplies the shared attention attrs only when the motion-residual route explicitly refused, preserving graph-native motion precedence without a Python winner or a cross-unit comparison. No task- or world-specific vocabulary.",
  "nodes": [
    {
      "local_id": 0,
      "type": "FoveaResolver",
      "attrs": {
        "purpose": "held_prediction_attention",
        "evidence_unit": "photon_count_quanta",
        "goal_logweight_default": 0.0
      }
    }
  ],
  "edges": [
    {
      "src": {
        "role": "agent_root"
      },
      "type": "has_held_prediction_attention_resolver",
      "tgt": {
        "local": 0
      },
      "attrs": {}
    }
  ],
  "productions": [
    {
      "provenance": "seed:held_prediction_attention:agent-resolver",
      "src": {
        "type": "Agent",
        "var": "agent"
      },
      "edge_type": "has_held_prediction_attention_resolver",
      "tgt": {
        "type": "FoveaResolver",
        "var": "resolver"
      }
    },
    {
      "provenance": "seed:held_prediction_attention:agent-residual",
      "src": {
        "type": "Agent",
        "var": "agent"
      },
      "edge_type": "perceives_prediction_residual",
      "tgt": {
        "type": "HeldPredictionResidual",
        "var": "residual"
      }
    },
    {
      "provenance": "seed:held_prediction_attention:candidate-evidence",
      "src": {
        "type": "FoveaCandidate",
        "var": "candidate"
      },
      "edge_type": "based_on_prediction_residual",
      "tgt": {
        "type": "HeldPredictionResidual",
        "var": "residual"
      }
    }
  ],
  "rules": [
