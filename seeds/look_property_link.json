{
 "id": "look_property_link",
 "version": "1.0.0",
 "self_load_only": true,
 "depends_on": [
  "colour_property",
  "looking_episode"
 ],
 "latency_class": "hard_realtime",
 "description": "Mary's Room stage 4.5 (seed 5): links a SurfaceLook (looking_episode) to its surface's ColourProperty (colour_property) through that epoch's rung-1 PropertyCheck: status minted|holds -> look -presents_property-> property; refused -> look -presents_unrecognised-> property; no check -> no link. presents_as is not used (deformation_beneficiary). Only rung 1 links; rung 2 stays on the PropertyCheck. Gated on ColourPropertyParams.enabled and LookingEpisodeParams.enabled, both OFF by default (sec 9). See tools/build_look_property_link_seed.py.",
 "microtheory": {
  "name": "look_property_link",
  "description": "looks -> the colour property they present (or fail to)"
 },
 "nodes": [],
 "edges": [],
 "productions": [],
 "rules": [
  {
   "name": "lk_presents",
   "comment": "The look presents the surface's held property when that epoch's rung-1 PropertyCheck holds, or at the minting epoch.",
   "match": [
    [
     "K",
     "look_of",
     "P"
    ],
    [
     "P",
     "has_colour_property",
     "CP"
    ]
   ],
   "where": {
    "type": "And",
    "items": [
     {
      "type": "And",
      "items": [
       {
        "type": "Gt",
        "a": {
         "type": "MaxOver",
         "source": {
          "type": "NodesOfType",
          "node_type": "ColourPropertyParams"
         },
         "var_name": "cpp_",
         "value": {
          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "cpp_"
          },
          "key": "enabled"
         },
         "default": {
          "type": "Lit",
          "value": 0.0
         }
        },
        "b": {
         "type": "Lit",
         "value": 0.5
        }
       },
       {
        "type": "Gt",
        "a": {
         "type": "MaxOver",
         "source": {
          "type": "NodesOfType",
          "node_type": "LookingEpisodeParams"
         },
         "var_name": "lep_",
         "value": {
          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "lep_"
          },
          "key": "enabled"
         },
         "default": {
          "type": "Lit",
          "value": 0.0
         }
        },
        "b": {
         "type": "Lit",
         "value": 0.5
        }
       }
      ]
     },
     {
      "type": "Eq",
      "a": {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "K"
       },
       "key": "link"
      },
      "b": {
       "type": "Lit",
       "value": null
      }
     },
     {
      "type": "Exists",
      "source": {
       "type": "Filter",
       "source": {
        "type": "InNeighbours",
        "node": {
         "type": "Var",
         "name": "CP"
        },
        "edge_type": "check_of",
        "any_type": false
       },
       "var_name": "kh_",
       "predicate": {
        "type": "Eq",
        "a": {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "kh_"
         },
         "key": "epoch"
        },
        "b": {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "K"
         },
         "key": "epoch"
        }
       }
      },
      "var_name": "kh_x",
      "predicate": {
       "type": "Or",
       "items": [
        {
         "type": "Eq",
         "a": {
          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "kh_x"
          },
          "key": "status"
         },
         "b": {
          "type": "Lit",
          "value": "minted"
         }
        },
        {
         "type": "Eq",
         "a": {
          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "kh_x"
          },
          "key": "status"
         },
         "b": {
          "type": "Lit",
          "value": "holds"
         }
        }
       ]
      }
     }
    ]
   },
   "effects": [
    [
     "add_edge",
     "K",
     "presents_property",
     "CP"
    ],
    [
     "set_attr",
     "K",
     "link",
     "property"
    ]
   ]
  },
  {
   "name": "lk_unrecognised",
   "comment": "The look presents the surface but NOT its held property: that epoch's rung-1 PropertyCheck refused (the property is unchanged; the look is linked as unrecognised).",
   "match": [
    [
     "K",
     "look_of",
     "P"
    ],
    [
     "P",
     "has_colour_property",
     "CP"
    ]
   ],
   "where": {
    "type": "And",
    "items": [
     {
      "type": "And",
      "items": [
       {
        "type": "Gt",
        "a": {
         "type": "MaxOver",
         "source": {
          "type": "NodesOfType",
          "node_type": "ColourPropertyParams"
         },
         "var_name": "cpp_",
         "value": {
          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "cpp_"
          },
          "key": "enabled"
         },
         "default": {
          "type": "Lit",
          "value": 0.0
         }
        },
        "b": {
         "type": "Lit",
         "value": 0.5
        }
       },
       {
        "type": "Gt",
        "a": {
         "type": "MaxOver",
         "source": {
          "type": "NodesOfType",
          "node_type": "LookingEpisodeParams"
         },
         "var_name": "lep_",
         "value": {
          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "lep_"
          },
          "key": "enabled"
         },
         "default": {
          "type": "Lit",
          "value": 0.0
         }
        },
        "b": {
         "type": "Lit",
         "value": 0.5
        }
       }
      ]
     },
     {
      "type": "Eq",
      "a": {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "K"
       },
       "key": "link"
      },
      "b": {
       "type": "Lit",
       "value": null
      }
     },
     {
      "type": "Exists",
      "source": {
       "type": "Filter",
       "source": {
        "type": "InNeighbours",
        "node": {
         "type": "Var",
         "name": "CP"
        },
        "edge_type": "check_of",
        "any_type": false
       },
       "var_name": "kr_",
       "predicate": {
        "type": "Eq",
        "a": {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "kr_"
         },
         "key": "epoch"
        },
        "b": {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "K"
         },
         "key": "epoch"
        }
       }
      },
      "var_name": "kr_x",
      "predicate": {
       "type": "Or",
       "items": [
        {
         "type": "Eq",
         "a": {
          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "kr_x"
          },
          "key": "status"
         },
         "b": {
          "type": "Lit",
          "value": "refused"
         }
        }
       ]
      }
     }
    ]
   },
   "effects": [
    [
     "add_edge",
     "K",
     "presents_unrecognised",
     "CP"
    ],
    [
     "set_attr",
     "K",
     "link",
     "unrecognised"
    ]
   ]
  }
 ]
}
