{
  "id": "global_illumination_eye",
  "version": "1.0.0",
  "depends_on": [
    "allocentric_world_view"
  ],
  "description": "Default-off graph-native visual illumination inference for the split photon eye. A dense high-acuity foveal measurement can propose a rapid field-wide gain change while a sparse broad-field scout confirms that the change is global rather than local. The hypothesis is explicitly predicted and remains distinct from observed photon evidence. Confirmed gain reconditions every unobserved renderable AllocentricWorldViewCell without overwriting its observed surface_value or provenance. Per-exposure work is constant plus one bounded pass over held visible-surface cells; transient evidence and superseded hypotheses are retired.",
  "microtheory": {
    "name": "global_illumination_eye",
    "description": "foveal lead, broad-field corroboration, and provenance-preserving whole-field appearance prediction"
  },
