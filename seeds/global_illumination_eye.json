          {"type": "Not", "arg": {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "cell"}, "key": "surface_illumination_epoch"}, "b": {"type": "Attr", "node": {"type": "Var", "name": "hypothesis"}, "key": "source_epoch"}}}
