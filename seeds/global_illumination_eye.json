    {
      "local_id": 0,
      "type": "GlobalIlluminationParams",
      "attrs": {
        "enabled": 0.0,
        "foveal_weight": 0.7,
        "global_weight": 0.3,
        "minimum_relative_change": 0.08,
        "maximum_pathway_gain_disagreement": 0.2,
        "minimum_mean_quanta": 1.0
      }
    },
    {
      "local_id": 1,
      "type": "IlluminationAdaptationState",
      "attrs": {
        "initialized": 0.0,
        "foveal_baseline_quanta": 0.0,
        "global_baseline_quanta": 0.0,
