  "rules": [
    {
      "name": "slang_variant_bind_denotes",
      "match_type": "SlangVariant",
      "match": [
        [
          "agent",
          "knows_variant",
          "v"
        ]
      ],
      "where": {
        "type": "Not",
        "arg": {
          "type": "Exists",
          "var_name": "_x",
          "predicate": {
            "type": "Lit",
            "value": true
          },
          "source": {
            "type": "Neighbours",
            "node": {
              "type": "Var",
              "name": "v"
            },
            "edge_type": "denotes",
            "any_type": false
          }
        }
      },
      "effects": [
        [
          "add_node_if_absent",
          "c",
          "Concept",
          {
            "name": {
              "__term__": {
                "type": "Attr",
                "node": {
                  "type": "Var",
                  "name": "v"
                },
                "key": "denotes_name"
              }
            }
          }
        ],
        [
          "add_edge",
          "v",
          "denotes",
          "c"
        ]
      ]
    },
    {
      "name": "resolve_slang_variant",
      "match": [
        [
          "agent",
          "knows_variant",
          "v"
        ],
        [
          "v",
          "denotes",
          "c"
        ],
        [
          "m",
          "has_mention",
          "mention"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Eq",
            "a": {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "mention"
              },
              "key": "text"
            },
            "b": {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "v"
              },
              "key": "form"
            }
          },
          {
            "type": "Not",
            "arg": {
              "type": "Exists",
              "var_name": "_ign",
              "predicate": {
                "type": "Lit",
                "value": true
              },
              "source": {
                "type": "Neighbours",
                "node": {
                  "type": "Var",
                  "name": "mention"
                },
                "edge_type": "refers_to"
              }
            }
          }
        ]
      },
      "effects": [
        [
          "add_edge",
          "mention",
          "refers_to",
          "c"
        ],
        [
          "add_edge",
          "mention",
          "via_variant",
          "v"
        ]
      ]
    }
  ]
}