          "cond": {
           "type": "Eq",
           "a": {
            "type": "Attr",
            "node": {
             "type": "Var",
             "name": "r"
            },
            "key": "axis_kind"
           },
           "b": {
            "type": "Lit",
            "value": "controllable"
           }
          },
          "then": {
           "type": "Lit",
           "value": 1.0
          },
          "other": {
           "type": "Lit",
           "value": 0.0
          }
         }
        ]
       },
       "other": {
        "type": "Plus",
        "items": [
