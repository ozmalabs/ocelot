     "g",
     "has_region",
     "r"
    ]
   ],
   "where": {
    "type": "And",
    "items": [
     {
      "type": "Eq",
      "a": {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "r"
       },
       "key": "axis_kind"
      },
      "b": {
       "type": "Lit",
       "value": "controllable"
      }
     },
     {
      "type": "Lt",
      "a": {
       "type": "Plus",
       "items": [
        {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "r"
         },
         "key": "is_self"
        },
        {
         "type": "Lit",
         "value": 0.0
        }
       ]
      },
      "b": {
       "type": "Lit",
       "value": 0.5
      }
     }
    ]
   },
   "effects": [
    [
     "set_attr",
     "r",
     "is_self",
     1.0
    ]
   ]
  },
  {
