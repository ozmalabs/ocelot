          "items": [
           {
            "type": "Attr",
            "node": {
             "type": "Var",
             "name": "w"
            },
            "key": "committed_n"
           },
           {
            "type": "Lit",
            "value": 0.0
           }
          ]
         },
         {
          "type": "Lit",
          "value": 1.0
         }
