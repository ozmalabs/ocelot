   "comment": "Per frame, for the self region + the window: always track the window's own prev_action (classify overwrites the region's classified_under every frame, so committed must use the WINDOW's prev). On a committed self frame (under the cap) fold committed_n+=1 and held_n+=(axis_kind==controllable). Folded so it counts once per frame, not per fixpoint pass.",
   "match": [
    [
     "g",
     "has_region",
     "r"
    ],
    [
     "g",
     "has_window",
     "w"
    ]
   ],
   "where": {
    "type": "Gt",
    "a": {
     "type": "Plus",
     "items": [
      {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "r"
       },
       "key": "is_self"
      },
      {
       "type": "Lit",
       "value": 0.0
      }
     ]
    },
    "b": {
     "type": "Lit",
     "value": 0.5
    }
   },
   "effects": [
    [
     "set_attr",
     "w",
     "clocked",
