 "version": "1.0.0",
 "area": "self_monitoring",
 "latency_class": "hard_realtime",
 "depends_on": [
  "self_repair"
 ],
 "description": "Measure the self/world discriminator's self-id stability from live perception and bank it onto a repairable axis, so fault_detect_regression fires on a REAL regression. Generated by scripts/gen_self_id_stability_seed.py.",
 "microtheory": {
  "name": "self_id_stability",
  "description": "self-id holds under committed action -> high stability; a flip -> low -> autonomous repair"
 },
