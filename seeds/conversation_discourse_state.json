{
  "id": "conversation_discourse_state",
  "version": "1.0.0",
  "depends_on": ["conversation"],
  "description": "Vocabulary manifest for graph-resident discourse state and communicative-goal lifecycle. Transition authority is the bounded domains/discourse_state faculty.",
  "nodes": [],
  "edges": [],
  "productions": [],
  "rules": [
    {
      "name": "discourse_goal_select",
      "comment": "Native lifecycle transition: a later selection event moves a proposed goal to selected.",
      "match_type": "Goal",
      "match": [
        ["state", "has_active_goal", "goal"],
        ["goal", "originated_in", "origin"],
        ["state", "has_event", "event"]
      ],
      "where": {
        "type": "And",
        "items": [
          {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "goal"}, "key": "lifecycle_status"}, "b": {"type": "Lit", "value": "proposed"}},
          {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "event"}, "key": "kind"}, "b": {"type": "Lit", "value": "selection"}},
          {"type": "Gt", "a": {"type": "Attr", "node": {"type": "Var", "name": "event"}, "key": "event_index"}, "b": {"type": "Attr", "node": {"type": "Var", "name": "origin"}, "key": "event_index"}}
        ]
      },
      "effects": [
        ["set_attr", "goal", "lifecycle_status", "selected"],
        ["set_attr", "goal", "status", "selected"],
        ["set_attr", "goal", "last_transition_event", {"__term__": {"type": "Var", "name": "event"}}],
        ["add_edge", "goal", "transitioned_by", "event"]
      ]
    },
    {
      "name": "discourse_goal_execute",
      "comment": "Native lifecycle transition: an execution event moves a selected goal to executing.",
      "match_type": "Goal",
      "match": [["state", "has_active_goal", "goal"], ["goal", "originated_in", "origin"], ["state", "has_event", "event"]],
      "where": {
        "type": "And",
        "items": [
          {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "goal"}, "key": "lifecycle_status"}, "b": {"type": "Lit", "value": "selected"}},
          {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "event"}, "key": "kind"}, "b": {"type": "Lit", "value": "execution"}},
          {"type": "Gt", "a": {"type": "Attr", "node": {"type": "Var", "name": "event"}, "key": "event_index"}, "b": {"type": "Attr", "node": {"type": "Var", "name": "origin"}, "key": "event_index"}}
        ]
      },
      "effects": [["set_attr", "goal", "lifecycle_status", "executing"], ["set_attr", "goal", "status", "executing"], ["set_attr", "goal", "last_transition_event", {"__term__": {"type": "Var", "name": "event"}}], ["add_edge", "goal", "transitioned_by", "event"]]
    },
    {
      "name": "discourse_goal_resolve",
      "comment": "Native lifecycle transition: a result event resolves an executing goal and records closure.",
      "match_type": "Goal",
      "match": [["state", "has_active_goal", "goal"], ["goal", "originated_in", "origin"], ["state", "has_event", "event"]],
      "where": {
        "type": "And",
        "items": [
          {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "goal"}, "key": "lifecycle_status"}, "b": {"type": "Lit", "value": "executing"}},
          {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "event"}, "key": "kind"}, "b": {"type": "Lit", "value": "action_result"}},
          {"type": "Gt", "a": {"type": "Attr", "node": {"type": "Var", "name": "event"}, "key": "event_index"}, "b": {"type": "Attr", "node": {"type": "Var", "name": "origin"}, "key": "event_index"}}
        ]
      },
      "effects": [["set_attr", "goal", "lifecycle_status", "resolved"], ["set_attr", "goal", "status", "resolved"], ["set_attr", "goal", "outcome", "native_event_result"], ["set_attr", "goal", "last_transition_event", {"__term__": {"type": "Var", "name": "event"}}], ["add_edge", "goal", "transitioned_by", "event"], ["add_edge", "state", "has_closed_goal", "goal"]]
    }
  ]
}
