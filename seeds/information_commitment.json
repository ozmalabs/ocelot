       "type": "Exists",
       "source": {
        "type": "Neighbours",
        "node": {
         "type": "Var",
         "name": "candidate"
        },
        "edge_type": "has_effect_footprint",
        "any_type": false
       },
       "var_name": "fp",
       "predicate": {
        "type": "Lit",
        "value": true
