{
  "id": "cognitive_rule_frames",
  "version": "1.0.0",
  "depends_on": [],
  "description": "Generic resident-held interpretation of rule-like documents. These rules only activate private HeldRule frames and mint candidate predictions; they never enforce a game, law, charter, contract, recipe, or social convention in a world.",
  "microtheory": {"name": "cognitive_rule_frames", "description": "held rules predict and guide without becoming world mechanics"},
  "concepts": [
    {"name": "held_rule", "definition": "A resident's private, fallible interpretation of rule-like text, with provenance and confidence."},
    {"name": "rule_activation", "definition": "A candidate application of one private held rule to one current observation."},
    {"name": "rule_prediction", "definition": "An expected consequence, procedure, permission, or norm generated by a resident's held rule."},
    {"name": "rule_commitment", "definition": "An explicit resident decision to use a rule prediction as a goal, plan input, or communication input."}
  ],
  "nodes": [],
  "edges": [],
  "productions": [],
  "rules": [
    {
      "name": "crf_activate_on_shared_cue",
      "match": [
        ["agent", "is_a", "agent_class"],
        ["agent", "holds_rule_document", "book"],
        ["book", "has_rule", "rule"],
        ["rule", "has_cue", "rule_cue"],
        ["agent", "has_cognitive_observation", "observation"],
        ["observation", "has_cue", "observed_cue"]
      ],
      "where": {"type": "And", "items": [
        {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "rule"}, "key": "status"}, "b": {"type": "Lit", "value": "held"}},
        {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "observation"}, "key": "status"}, "b": {"type": "Lit", "value": "current"}},
        {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "rule_cue"}, "key": "surface"}, "b": {"type": "Attr", "node": {"type": "Var", "name": "observed_cue"}, "key": "surface"}}
      ]},
      "effects": [
        ["add_node_if_absent", "activation", "RuleActivation", {
          "key": {"__term__": {"type": "StringConcat", "parts": [
            {"type": "Attr", "node": {"type": "Var", "name": "rule"}, "key": "rule_key"},
            {"type": "Lit", "value": "::"},
            {"type": "Attr", "node": {"type": "Var", "name": "observation"}, "key": "observation_key"}
          ]}},
          "status": "candidate",
          "rule_key": {"__term__": {"type": "Attr", "node": {"type": "Var", "name": "rule"}, "key": "rule_key"}},
          "observation_key": {"__term__": {"type": "Attr", "node": {"type": "Var", "name": "observation"}, "key": "observation_key"}},
          "cue": {"__term__": {"type": "Attr", "node": {"type": "Var", "name": "rule_cue"}, "key": "surface"}},
          "confidence": {"__term__": {"type": "Attr", "node": {"type": "Var", "name": "rule"}, "key": "confidence"}}
        }],
        ["add_edge", "agent", "has_rule_activation", "activation"],
        ["add_edge", "activation", "for_rule", "rule"],
        ["add_edge", "activation", "for_observation", "observation"],
        ["add_edge", "activation", "based_on_cue", "rule_cue"]
      ]
    },
    {
      "name": "crf_predict_from_activation",
      "match": [
        ["agent", "is_a", "agent_class"],
        ["agent", "has_rule_activation", "activation"],
        ["activation", "for_rule", "rule"],
        ["activation", "for_observation", "observation"]
      ],
      "where": {"type": "And", "items": [
        {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "activation"}, "key": "status"}, "b": {"type": "Lit", "value": "candidate"}},
        {"type": "Not", "arg": {"type": "Exists", "source": {"type": "InNeighbours", "node": {"type": "Var", "name": "activation"}, "edge_type": "has_prediction"}, "var_name": "existing_prediction", "predicate": {"type": "Lit", "value": true}}}
      ]},
      "effects": [
        ["add_node_if_absent", "prediction", "RulePrediction", {
          "key": {"__term__": {"type": "Attr", "node": {"type": "Var", "name": "activation"}, "key": "key"}},
          "status": "candidate",
          "surface": {"__term__": {"type": "Attr", "node": {"type": "Var", "name": "rule"}, "key": "consequence_text"}},
          "rule_kind": {"__term__": {"type": "Attr", "node": {"type": "Var", "name": "rule"}, "key": "kind"}},
          "confidence": {"__term__": {"type": "Attr", "node": {"type": "Var", "name": "rule"}, "key": "confidence"}},
          "observation_key": {"__term__": {"type": "Attr", "node": {"type": "Var", "name": "observation"}, "key": "observation_key"}}
        }],
        ["add_edge", "activation", "has_prediction", "prediction"],
        ["add_edge", "agent", "has_rule_prediction", "prediction"]
      ]
    }
  ]
}
