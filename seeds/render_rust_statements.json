{
 "seed": {
  "id": "render_rust_statements",
  "version": "1.0.0",
  "language": "rust",
  "depends_on": []
 },
 "doc": "Statement-grain RUST renderer as graph-resident RenderRules (P5 track B). Hub Program IR (P1 Prog* variants + expression DSL) -> compilable rust source, inverse of seeds/rust_correspondence.json (P2). Installed by domains/render_rust_lua.py:install_renderer(sub, 'rust'). Extends past the old seed_rust_renderer integer-expression rules: floats/bools/strings (ToJsonString literal spelling), statements, fn items via the mechanical wrapper.",
 "render_gaps": [
  "Div",
  "Pow",
  "ProgFString",
  "ProgTryOr",
  "ProgRaise",
  "ProgImportStmt",
  "ProgAttrGet",
  "ProgAttrSet",
  "ProgTupleUnpack",
  "ProgIsOp",
  "ProgComprehensionList",
  "ProgComprehensionGen"
 ],
 "render_rules": [
  {
   "head": "Lit",
   "binding_pattern": [
    "value"
   ],
   "template": {
    "type": "Cat",
    "items": [
     {
      "type": "ToJsonString",
      "value": {
       "type": "Slot",
       "name": "value"
      }
     }
    ]
   },
   "note": "Type-aware literal spelling via ToJsonString (in-graph): true/false, 7, 2.5, \"s\" \u2014 closes the old renderer's integer-only ('<n>i64') gap; bare ints stay polymorphic so usize/i64 inference works in index vs arithmetic positions.",
   "teachable": false
  },
  {
   "head": "Var",
   "binding_pattern": [
    "name"
   ],
   "template": {
    "type": "Cat",
    "items": [
     {
      "type": "Slot",
      "name": "name"
     }
    ]
   },
   "note": "identifier verbatim",
   "teachable": true,
   "teach_spec": [
    "Cat",
    [
     "Slot",
     "name"
    ]
   ]
  },
  {
   "head": "Eq",
   "binding_pattern": [
    "a",
    "b"
   ],
   "template": {
    "type": "Cat",
    "items": [
     {
      "type": "Surface",
      "kind": "text",
      "payload": "("
     },
     {
      "type": "Render",
      "term": {
       "type": "Slot",
       "name": "a"
      }
     },
     {
      "type": "Surface",
      "kind": "text",
      "payload": " == "
     },
     {
      "type": "Render",
      "term": {
       "type": "Slot",
       "name": "b"
      }
     },
     {
      "type": "Surface",
      "kind": "text",
      "payload": ")"
     }
    ]
   },
   "note": "binary Eq -> '(a == b)'; parens are transparent on re-read (unwrap_paren). hub IDiv IS rust integer '/' (both truncate); hub Div (true division) has NO rust rule \u2014 honest gap.",
   "teachable": true,
   "teach_spec": [
    "Cat",
    [
     "Surface",
     "text",
     "("
    ],
    [
     "Render",
     [
      "Slot",
      "a"
     ]
    ],
    [
     "Surface",
     "text",
     " == "
    ],
    [
     "Render",
     [
      "Slot",
      "b"
     ]
    ],
    [
     "Surface",
     "text",
     ")"
    ]
   ]
  },
