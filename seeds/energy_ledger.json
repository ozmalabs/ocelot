{
 "id": "energy_ledger",
 "version": "1.0.0",
 "depends_on": [
  "embodied_learning_session"
 ],
 "description": "THE STOCK. Consumption was already measured on every receipt; no level was ever carried, so the books could not close and the option margin had no affordability term. This carries opening, intake, expenditure and stock as integer columns, keeps the AMOUNT and RATE ceilings apart, and projects reachable = min(stock, rate x horizon). Expenditure is summed from posted receipts rather than accumulated, so it is idempotent under the fixpoint. Every quantity carries a `_measured` companion so a declared default is never confusable with an observation.",
 "microtheory": "energy_ledger",
 "nodes": [],
 "edges": [],
 "productions": [
  {
   "provenance": "seed:energy_ledger:has_energy_ledger-0",
   "src": {
    "type": "EmbodiedDevelopmentEpisode",
    "var": "s"
   },
   "edge_type": "has_energy_ledger",
   "tgt": {
    "type": "EnergyLedger",
    "var": "t"
   }
  },
  {
   "provenance": "seed:energy_ledger:has_posted_receipt-1",
   "src": {
    "type": "EnergyLedger",
    "var": "s"
   },
   "edge_type": "has_posted_receipt",
   "tgt": {
    "type": "EmbodiedLearningTrialReceipt",
    "var": "t"
   }
  }
 ],
 "rules": [
  {
   "name": "enl_open_energy_ledger",
   "area": "general_cognition",
   "latency_class": "hard_realtime",
   "comment": "One durable ledger per embodied episode. The opening balance is a DECLARED default, not a measurement, and says so: `stock_measured` is 0 until a world publishes an observed level. A declared budget is usable; it is never confusable with an observation.",
   "match": [
    [
     "agent",
     "has_embodied_development_episode",
     "episode"
    ]
   ],
   "where": {
    "type": "Not",
    "arg": {
     "type": "Exists",
     "source": {
      "type": "Neighbours",
      "node": {
       "type": "Var",
       "name": "episode"
      },
      "edge_type": "has_energy_ledger"
     },
     "var_name": "prior",
     "predicate": {
      "type": "Lit",
      "value": true
     }
    }
   },
   "effects": [
    [
     "add_node",
     "ledger",
     "EnergyLedger",
     {
      "opening_units": 1000,
      "intake_units": 0,
      "expenditure_units": 0,
      "stock_units": 1000,
      "stock_measured": 0,
      "rate_ceiling_units": 50,
      "rate_ceiling_measured": 0,
      "horizon_actions": 8,
      "reachable_units": 0,
      "posted_receipt_count": 0,
      "integer_native": 1,
      "output_authority": 0
     }
    ],
    [
     "add_edge",
     "episode",
     "has_energy_ledger",
     "ledger"
    ]
   ]
  },
  {
   "name": "enl_post_closed_receipt_to_ledger",
   "area": "general_cognition",
   "latency_class": "soft_realtime",
   "comment": "A causally closed receipt is an accounting document. Posting is an EDGE only \u2014 the amount is never accumulated into a running total, because a fixpoint that re-fires would double-count it. The balance is summed from the posted set instead, so posting is idempotent by construction and the ledger cannot drift.",
   "match": [
    [
     "episode",
     "has_energy_ledger",
     "ledger"
    ],
    [
     "episode",
     "has_embodied_development_receipt",
     "receipt"
    ]
   ],
   "where": {
    "type": "And",
    "items": [
     {
      "type": "Eq",
      "a": {
       "type": "Plus",
       "items": [
        {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "receipt"
         },
         "key": "development_receipt_closed"
        },
        {
         "type": "Lit",
         "value": 0
        }
       ]
      },
      "b": {
       "type": "Lit",
       "value": 1
      }
     },
     {
      "type": "Not",
      "arg": {
       "type": "Exists",
       "source": {
        "type": "Neighbours",
        "node": {
         "type": "Var",
         "name": "ledger"
        },
        "edge_type": "has_posted_receipt"
       },
       "var_name": "posted",
       "predicate": {
        "type": "Eq",
        "a": {
         "type": "Var",
         "name": "posted"
        },
        "b": {
         "type": "Var",
         "name": "receipt"
        }
       }
      }
     }
    ]
   },
   "effects": [
    [
     "add_edge",
     "ledger",
     "has_posted_receipt",
     "receipt"
    ]
   ]
  },
  {
   "name": "enl_settle_energy_balance",
   "area": "general_cognition",
   "latency_class": "hard_realtime",
   "comment": "Intake = expenditure + storage, the identity the agent already holds, evaluated over the posted set. Recomputed from the documents every pass rather than carried forward, so it is always exactly the sum of what was posted. With no intake source the stock is monotone non-increasing \u2014 which is the claim an aircraft's throttle falsifies and which only closes once the convertible stock is carried as its own column.",
   "match": [
    [
     "episode",
     "has_energy_ledger",
     "ledger"
    ]
   ],
   "where": {
    "type": "Lit",
    "value": true
   },
   "effects": [
    [
     "set_attr",
     "ledger",
     "expenditure_units",
     {
      "__term__": {
       "type": "Sum",
       "source": {
        "type": "Neighbours",
        "node": {
         "type": "Var",
         "name": "ledger"
        },
        "edge_type": "has_posted_receipt"
       },
       "var_name": "posted",
       "value": {
        "type": "Plus",
        "items": [
         {
          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "posted"
          },
          "key": "energy_cost_units"
         },
         {
          "type": "Lit",
          "value": 0
         }
        ]
       }
      }
     }
    ],
    [
     "set_attr",
     "ledger",
     "stock_units",
     {
      "__term__": {
       "type": "Minus",
       "a": {
        "type": "Plus",
        "items": [
         {
          "type": "Plus",
          "items": [
           {
            "type": "Attr",
            "node": {
             "type": "Var",
             "name": "ledger"
            },
            "key": "opening_units"
           },
           {
            "type": "Lit",
            "value": 0
           }
          ]
         },
         {
          "type": "Plus",
          "items": [
           {
            "type": "Attr",
            "node": {
             "type": "Var",
             "name": "ledger"
            },
            "key": "intake_units"
           },
           {
            "type": "Lit",
            "value": 0
           }
          ]
         }
        ]
       },
       "b": {
        "type": "Sum",
        "source": {
         "type": "Neighbours",
         "node": {
          "type": "Var",
          "name": "ledger"
         },
         "edge_type": "has_posted_receipt"
        },
        "var_name": "posted",
        "value": {
         "type": "Plus",
         "items": [
          {
           "type": "Attr",
           "node": {
            "type": "Var",
            "name": "posted"
           },
           "key": "energy_cost_units"
          },
          {
           "type": "Lit",
           "value": 0
          }
         ]
        }
       }
      }
     }
    ],
    [
     "set_attr",
     "ledger",
     "posted_receipt_count",
     {
      "__term__": {
       "type": "Count",
       "source": {
        "type": "Neighbours",
        "node": {
         "type": "Var",
         "name": "ledger"
        },
        "edge_type": "has_posted_receipt"
       }
      }
     }
    ]
   ]
  },
  {
   "name": "enl_project_reachable_within_horizon",
   "area": "general_cognition",
   "latency_class": "hard_realtime",
   "comment": "reachable = min(stock, rate x horizon). The AMOUNT ceiling and the RATE ceiling are different quantities and neither alone answers affordability: a full tank cannot be spent faster than the actuator converts it, and an unlimited conversion rate cannot spend a tank that is empty. This is the humanoid form of the F16 fuel ledger's min(remaining fuel, max power x H).",
   "match": [
    [
     "episode",
     "has_energy_ledger",
     "ledger"
    ]
   ],
   "where": {
    "type": "Lit",
    "value": true
   },
   "effects": [
    [
     "set_attr",
     "ledger",
     "reachable_units",
     {
      "__term__": {
       "type": "Min",
       "items": [
        {
         "type": "Plus",
         "items": [
          {
           "type": "Attr",
           "node": {
            "type": "Var",
            "name": "ledger"
           },
           "key": "stock_units"
          },
          {
           "type": "Lit",
           "value": 0
          }
         ]
        },
        {
         "type": "Times",
         "items": [
          {
           "type": "Plus",
           "items": [
            {
             "type": "Attr",
             "node": {
              "type": "Var",
              "name": "ledger"
             },
             "key": "rate_ceiling_units"
            },
            {
             "type": "Lit",
             "value": 0
            }
           ]
          },
          {
           "type": "Plus",
           "items": [
            {
             "type": "Attr",
             "node": {
              "type": "Var",
              "name": "ledger"
             },
             "key": "horizon_actions"
            },
            {
             "type": "Lit",
             "value": 0
            }
           ]
          }
         ]
        }
       ]
      }
     }
    ]
   ]
  },
  {
   "name": "enl_raise_rate_ceiling_to_observed_peak",
   "area": "general_cognition",
   "latency_class": "soft_realtime",
   "comment": "A ceiling the body has already exceeded was never the ceiling. The observed peak supersedes the declared default and `rate_ceiling_measured` flips to 1, so a consumer can tell an observed limit from an assumed one.",
   "match": [
    [
     "ledger",
     "has_posted_receipt",
     "receipt"
    ]
   ],
   "where": {
    "type": "Gt",
    "a": {
     "type": "Plus",
     "items": [
      {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "receipt"
       },
       "key": "peak_load_units"
      },
      {
       "type": "Lit",
       "value": 0
      }
     ]
    },
    "b": {
     "type": "Plus",
     "items": [
      {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "ledger"
       },
       "key": "rate_ceiling_units"
      },
      {
       "type": "Lit",
       "value": 0
      }
     ]
    }
   },
   "effects": [
    [
     "set_attr",
     "ledger",
     "rate_ceiling_units",
     {
      "__term__": {
       "type": "Max",
       "items": [
        {
         "type": "Plus",
         "items": [
          {
           "type": "Attr",
           "node": {
            "type": "Var",
            "name": "ledger"
           },
           "key": "rate_ceiling_units"
          },
          {
           "type": "Lit",
           "value": 0
          }
         ]
        },
        {
         "type": "Plus",
         "items": [
          {
           "type": "Attr",
           "node": {
            "type": "Var",
            "name": "receipt"
           },
           "key": "peak_load_units"
          },
          {
           "type": "Lit",
           "value": 0
          }
         ]
        }
       ]
      }
     }
    ],
    [
     "set_attr",
     "ledger",
     "rate_ceiling_measured",
     1
    ]
   ]
  }
 ]
}
