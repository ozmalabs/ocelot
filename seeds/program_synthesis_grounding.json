  "rules": [
    {
      "name": "ps_ground_held_quantity_lexeme",
      "area": "program_synthesis",
      "latency_class": "background",
      "batch": true,
      "comment": "Exact surface-token equality grounds every matching held number lexeme onto the request. The vocabulary is graph data and can be taught without changing this rule.",
      "match": [
        [
          "agent",
          "received",
          "message"
        ],
        [
          "agent",
          "has_synthesis_quantity_lexeme",
          "quantity"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Eq",
            "a": {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "message"
              },
              "key": "ps_write_request"
            },
            "b": {
              "type": "Lit",
              "value": 1
            }
          },
          {
            "type": "In",
            "member": {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "quantity"
              },
              "key": "token"
            },
            "container": {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "message"
              },
              "key": "ps_surface_tokens"
            }
          },
          {
            "type": "Not",
            "arg": {
              "type": "Exists",
              "source": {
                "type": "Neighbours",
                "node": {
                  "type": "Var",
                  "name": "message"
                },
                "edge_type": "ps_grounds_quantity",
                "any_type": false
              },
              "var_name": "held_quantity",
              "predicate": {
                "type": "Eq",
                "a": {
                  "type": "Var",
                  "name": "held_quantity"
                },
                "b": {
                  "type": "Var",
                  "name": "quantity"
                }
              }
            }
          }
        ]
      },
      "effects": [
        [
          "add_edge",
          "message",
          "ps_grounds_quantity",
          "quantity"
        ]
      ]
    },
    {
      "name": "ps_select_synthesis_operator_shape",
      "area": "program_synthesis",
      "latency_class": "background",
      "comment": "Collapse matching held meta-shapes by trigger coverage. The winning graph node supplies the enumerator's operator inventory; the adapter only transcribes the decided fact.",
      "match": [
