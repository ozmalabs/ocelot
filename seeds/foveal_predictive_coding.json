          {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "assessment"}, "key": "status"}, "b": {"type": "Lit", "value": "raw"}},
          {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "assessment"}, "key": "prediction_present"}, "b": {"type": "Lit", "value": 0.0}},
          {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "assessment"}, "key": "source_epoch"}, "b": {"type": "Attr", "node": {"type": "Var", "name": "exposure"}, "key": "source_epoch"}},
          {"type": "Lt", "a": {"type": "Attr", "node": {"type": "Var", "name": "exposure"}, "key": "settled_count"}, "b": {"type": "Attr", "node": {"type": "Var", "name": "params"}, "key": "settlement_budget"}},
          {"type": "Not", "arg": {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "cell"}, "key": "foveal_latent_epoch"}, "b": {"type": "Attr", "node": {"type": "Var", "name": "exposure"}, "key": "source_epoch"}}},
          {
            "type": "Eq",
