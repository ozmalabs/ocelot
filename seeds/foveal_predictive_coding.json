  "rules": [
    {
      "name": "foveal_settle_largest_predicted_residual",
      "area": "vision",
      "order": 70,
      "latency_class": "hard_realtime",
      "comment": "Prediction error, not raw frame change, allocates the earned-detail path. ArgminUnique over negative residual is an exact-tie-refusing Argmax. Only a current, allocentrically grounded assessment can win.",
      "match": [
        ["agent", "has_foveal_predictive_params", "params"],
        ["agent", "has_foveal_exposure", "exposure"],
        ["exposure", "has_foveal_tile_assessment", "assessment"],
        ["assessment", "grounds_in_world_view", "cell"],
        ["assessment", "observes", "decoder"]
      ],
      "where": {
        "type": "And",
        "items": [
          {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "params"}, "key": "enabled"}, "b": {"type": "Lit", "value": 1.0}},
          {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "assessment"}, "key": "status"}, "b": {"type": "Lit", "value": "raw"}},
          {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "assessment"}, "key": "prediction_present"}, "b": {"type": "Lit", "value": 1.0}},
          {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "assessment"}, "key": "source_epoch"}, "b": {"type": "Attr", "node": {"type": "Var", "name": "exposure"}, "key": "source_epoch"}},
          {"type": "Lt", "a": {"type": "Attr", "node": {"type": "Var", "name": "exposure"}, "key": "settled_count"}, "b": {"type": "Attr", "node": {"type": "Var", "name": "params"}, "key": "settlement_budget"}},
          {"type": "Not", "arg": {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "cell"}, "key": "foveal_latent_epoch"}, "b": {"type": "Attr", "node": {"type": "Var", "name": "exposure"}, "key": "source_epoch"}}},
          {
            "type": "Eq",
            "a": {"type": "Var", "name": "assessment"},
            "b": {
              "type": "ArgminUnique",
              "source": {
                "type": "Filter",
                "source": {"type": "Neighbours", "node": {"type": "Var", "name": "exposure"}, "edge_type": "has_foveal_tile_assessment"},
                "var_name": "candidate",
                "predicate": {
                  "type": "And",
                  "items": [
                    {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "candidate"}, "key": "status"}, "b": {"type": "Lit", "value": "raw"}},
                    {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "candidate"}, "key": "world_grounded"}, "b": {"type": "Lit", "value": 1.0}},
                    {"type": "Eq", "a": {"type": "Attr", "node": {"type": "Var", "name": "candidate"}, "key": "prediction_present"}, "b": {"type": "Lit", "value": 1.0}}
                  ]
                }
              },
              "var_name": "candidate",
              "value": {
                "type": "Minus",
                "a": {"type": "Lit", "value": 0.0},
                "b": {"type": "Attr", "node": {"type": "Var", "name": "candidate"}, "key": "predicted_residual"}
              }
            }
          }
        ]
      },
      "effects": [
        ["set_attr", "cell", "foveal_latent", {"__term__": {"type": "Attr", "node": {"type": "Var", "name": "assessment"}, "key": "latent"}}],
        ["set_attr", "cell", "foveal_latent_epoch", {"__term__": {"type": "Attr", "node": {"type": "Var", "name": "assessment"}, "key": "source_epoch"}}],
        ["set_attr", "cell", "foveal_latent_confidence", {"__term__": {"type": "Attr", "node": {"type": "Var", "name": "assessment"}, "key": "world_confidence"}}],
        ["set_attr", "assessment", "settlement_reason", "predicted_residual"],
        ["set_attr", "assessment", "settlement_order", {"__term__": {"type": "Attr", "node": {"type": "Var", "name": "exposure"}, "key": "settled_count"}}],
        ["net_collapse", "decoder", {"__term__": {"type": "Attr", "node": {"type": "Var", "name": "assessment"}, "key": "input_vec"}}, {"__term__": {"type": "Attr", "node": {"type": "Var", "name": "assessment"}, "key": "target"}}, {"__term__": {"type": "Attr", "node": {"type": "Var", "name": "decoder"}, "key": "eta"}}],
        ["set_attr", "assessment", "status", "consumed"],
        ["set_attr", "exposure", "settled_count", {"__term__": {"type": "Plus", "items": [{"type": "Attr", "node": {"type": "Var", "name": "exposure"}, "key": "settled_count"}, {"type": "Lit", "value": 1}]}}]
      ]
