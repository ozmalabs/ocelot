       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "obs"
       },
       "key": "status"
      },
      "b": {
       "type": "Lit",
       "value": "gap_vseq"
      }
     },
     {
      "type": "Eq",
      "a": {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "ag"
       },
       "key": "gap_verify_enabled"
      },
      "b": {
       "type": "Lit",
       "value": 1
      }
     }
    ]
   },
   "effects": [
    [
     "set_attr",
     "obs",
     "verified",
     {
      "__term__": {
       "type": "IfThenElse",
       "cond": {
        "type": "Eq",
        "a": {
         "type": "GapVerify",
         "sequence": {
          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "obs"
          },
          "key": "frames"
         },
         "codebook_type": "ShapeSignature",
