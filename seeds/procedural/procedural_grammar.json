 "edges": [],
 "rules": [
  {
   "name": "retire_proc_probe_scratch",
   "comment": "The referent cross-check (procedural_reader._referent_crosscheck) ingests the method TEXT as a Message{proc_probe:1} + a has_mention Mention chain purely to DEMONSTRATE the graph's own recognition, then reads the count back and marks the Message proc_done:1. This rule then DECIDES that consumed scratch is disposable and DELETES the Mentions, so the (conversation-typed) demonstration leaves NO Mention node behind -- required when read_method runs inside the reading pipeline, whose invariant is that it mints only SmMention, never conversation Mention (test_reading_mints_no_conversation_mention_nodes). Gated on proc_done so it never fires during the cross-check's own resolve tick (proc_done unset there), only after the count is read back. The RETIRE is this rule's decision, not Python.",
   "match": [
    [
     "m",
     "has_mention",
     "n"
    ]
   ],
   "where": {
    "type": "Eq",
    "a": {
     "type": "Attr",
     "node": {
      "type": "Var",
      "name": "m"
     },
     "key": "proc_done"
    },
    "b": {
     "type": "Lit",
     "value": 1.0
    }
   },
   "effects": [
    [
     "del_node",
     "n"
    ],
    [
     "del_node",
     "m"
    ]
   ]
  }
 ]
}