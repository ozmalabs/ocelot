   "name": "msg_decode",
   "comment": "RUNG 1, DEQUANTIZE at the META-SHAPE grain: a pending ShapeObservation is decoded against the held MetaShape codebook via the UNCHANGED ShapeDecode Term, pointed at codebook_type='MetaShape'. This works with zero new Rust because shape_decode.rs::load_parts is grain-agnostic \u2014 it reads any codebook_type-typed node carrying `name` + `signature`. The eleven SEEDED MetaShapes carry no signature and are simply skipped by load_parts, which is why the keyword prior (msg_recognize_prior) still exists below.",
   "match_type": "ShapeObservation",
   "match": [
    [
     "ag",
     "observed_shape",
     "obs"
    ]
   ],
   "where": {
    "type": "Eq",
    "a": {
     "type": "Attr",
     "node": {
      "type": "Var",
      "name": "obs"
     },
     "key": "status"
    },
    "b": {
     "type": "Lit",
     "value": "pending"
    }
   },
   "effects": [
    [
     "set_attr",
     "obs",
     "decode",
     {
      "__term__": {
       "type": "ShapeDecode",
       "goal": {
        "type": "Attr",
        "node": {
         "type": "Var",
         "name": "obs"
        },
        "key": "signature"
       },
       "codebook_type": "MetaShape",
       "beam": 3,
       "max_steps": 8,
       "cand_k": 3,
       "wild_objects": false
      }
