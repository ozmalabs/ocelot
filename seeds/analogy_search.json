   "provenance": "analogy_search:observed_probe",
   "src": {
    "type": "Agent",
    "var": "ag"
   },
   "edge_type": "observed_probe",
   "tgt": {
    "type": "AnalogyProbe",
    "var": "obs"
   }
  },
