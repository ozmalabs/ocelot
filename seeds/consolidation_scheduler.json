      "local_id": 0,
      "type": "ConsolidationSchedulerPolicy",
      "attrs": {
        "enabled": 0.0,
        "entry_weight": 0.6,
        "maximum_task_demand": 0.2,
        "cooldown_epochs": 4.0,
        "retention_epochs": 4.0,
        "last_cycle_epoch": -1000000.0
      }
    },
    {
      "local_id": 1,
      "type": "SystemTwoTaskSet",
      "attrs": {
        "name": "consolidation_memory_replay",
