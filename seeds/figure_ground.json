{
  "id": "figure_ground",
  "version": "1.0.0",
  "depends_on": [
    "perception_core"
  ],
  "description": "The agent's SELF-COMPOSED figure/ground understanding as native concept definitions (registered for Holds): is_region / region_touches_boundary / bbox_inside_play atoms, composed into background_region (the ground), bounded_area (a THING), in_play. Passability = understanding bounds: a bound is impassable by default; the bounded_area is navigable. Ported from domains/figure_ground_concepts.py (CuriousAgent interface) to native register_concept Term-JSON.",
  "concepts": [
    {
      "name": "is_region",
      "domain": "space",
      "definition": {
        "type": "Gte",
        "a": {
          "type": "Count",
          "source": {
            "type": "InNeighbours",
            "node": {
              "type": "Var",
              "name": "x"
            },
            "edge_type": "within"
          }
        },
        "b": {
          "type": "Lit",
          "value": 1
        }
      },
      "comment": "atom: a Location with >=1 member cell (within-edge). Perceptual."
    },
    {
      "name": "region_touches_boundary",
      "domain": "space",
      "definition": {
