 "concepts": [
  {
   "name": "frontier_pick",
   "domain": "autonomy",
   "definition": {
    "type": "Argmax",
    "source": {
     "type": "NodesWhere",
     "node_type": "CapabilityAxis",
     "attr_key": "is_axis",
     "value": {
      "type": "Lit",
      "value": 1.0
     }
    },
    "var_name": "x",
    "value": {
     "type": "Plus",
     "items": [
      {
       "type": "Minus",
       "a": {
        "type": "Times",
        "items": [
         {
          "type": "Count",
          "source": {
           "type": "Neighbours",
           "node": {
            "type": "Var",
            "name": "x"
           },
           "edge_type": "unifies",
           "any_type": false
          }
         },
         {
          "type": "Lit",
          "value": 1000
         },
         {
          "type": "Minus",
          "a": {
           "type": "Lit",
           "value": 1.0
          },
          "b": {
           "type": "Attr",
           "node": {
            "type": "Var",
            "name": "x"
           },
           "key": "saturation"
          }
         }
        ]
       },
       "b": {
        "type": "Attr",
        "node": {
         "type": "Var",
         "name": "x"
        },
        "key": "min_order"
       }
      },
      {
       "type": "Times",
       "items": [
        {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "x"
         },
         "key": "shortfall"
        },
        {
         "type": "Lit",
         "value": 1000000000
        }
       ]
      }
     ]
    },
    "default": null
   },
   "comment": "MIGRATED: gap-ranking DECISION now graph data (was gap_prioritiser.pick_term, a Python builder)."
  },
  {
   "name": "plan_satisfaction",
   "domain": "autonomy",
   "definition": {
    "type": "Eq",
    "a": {
     "type": "Count",
     "source": {
      "type": "Filter",
      "source": {
       "type": "NodesOfType",
       "node_type": "PlanAct"
      },
      "var_name": "a",
      "predicate": {
       "type": "Eq",
       "a": {
        "type": "Attr",
        "node": {
         "type": "Var",
         "name": "a"
        },
        "key": "status"
       },
       "b": {
        "type": "Lit",
        "value": "pending"
       }
      }
     }
    },
    "b": {
     "type": "Lit",
     "value": 0
    }
   },
   "comment": "operational satisfaction-fold: a plan is done when no Act is pending."
  }
 ],
 "rules": [
  {
   "name": "mint_goal_from_frontier",
   "comment": "understand-drive standing error -> goal for the top frontier axis (materialized by the frontier_pick reflex as ag-frontier_pick->axis).",
   "match": [
    [
     "ag",
     "frontier_pick",
     "ax"
    ]
   ],
   "where": {
    "type": "Lt",
    "a": {
     "type": "Count",
     "source": {
      "type": "Neighbours",
      "node": {
       "type": "Var",
       "name": "ag"
      },
      "edge_type": "wants",
      "any_type": false
     }
    },
    "b": {
     "type": "Lit",
     "value": 1
    }
   },
   "effects": [
    [
     "add_edge",
     "ag",
     "wants",
     "ax"
    ]
   ]
  },
  {
   "name": "mint_goal_from_surprise",
   "comment": "goal from SURPRISE: an unresolved Impasse becomes something to understand.",
   "match": [
    [
     "ag",
     "surprised_by",
     "imp"
    ]
   ],
   "where": {
    "type": "And",
    "items": [
     {
      "type": "Not",
      "arg": {
       "type": "Eq",
       "a": {
        "type": "Attr",
        "node": {
         "type": "Var",
         "name": "imp"
        },
        "key": "resolved"
       },
       "b": {
        "type": "Lit",
        "value": true
       }
      }
     },
     {
      "type": "Lt",
      "a": {
       "type": "Count",
       "source": {
        "type": "Filter",
        "source": {
         "type": "Neighbours",
         "node": {
          "type": "Var",
          "name": "ag"
         },
         "edge_type": "wants",
         "any_type": false
        },
        "var_name": "g",
        "predicate": {
         "type": "Eq",
         "a": {
          "type": "Var",
          "name": "g"
         },
         "b": {
          "type": "Var",
          "name": "imp"
         }
        }
       }
      },
      "b": {
       "type": "Lit",
       "value": 1
      }
     }
    ]
   },
   "effects": [
    [
     "add_edge",
     "ag",
     "wants",
     "imp"
    ]
   ]
  },
  {
   "name": "satisfy_goal",
   "comment": "drop a satisfied goal (cuts the frontier item).",
   "match": [
    [
     "ag",
     "wants",
     "g"
    ]
   ],
   "where": {
    "type": "Eq",
    "a": {
     "type": "Attr",
     "node": {
      "type": "Var",
      "name": "g"
     },
     "key": "satisfied"
    },
    "b": {
     "type": "Lit",
     "value": 1.0
    }
   },
   "effects": [
    [
     "del_edge",
     "ag",
     "wants",
     "g"
    ]
   ]
  },
  {
   "name": "select_active_goal",
   "comment": "mark one wanted goal active when none is (weight-ranked Argmax is the refinement).",
   "match": [
    [
     "ag",
     "wants",
     "g"
    ]
   ],
   "where": {
    "type": "Lt",
    "a": {
     "type": "Count",
     "source": {
      "type": "Filter",
      "source": {
       "type": "Neighbours",
       "node": {
        "type": "Var",
        "name": "ag"
       },
       "edge_type": "wants",
       "any_type": false
      },
      "var_name": "x",
      "predicate": {
       "type": "Eq",
       "a": {
        "type": "Attr",
        "node": {
         "type": "Var",
         "name": "x"
        },
        "key": "active"
       },
       "b": {
        "type": "Lit",
        "value": 1.0
       }
      }
     }
    },
    "b": {
     "type": "Lit",
     "value": 1
    }
   },
   "effects": [
    [
     "set_attr",
     "g",
     "active",
     {
      "__term__": {
       "type": "Lit",
       "value": 1.0
      }
     }
    ]
   ]
  },
  {
   "name": "goal_from_procedure",
   "comment": "wrap a parsed plan-tree root as a WANTED goal, CONSUMING plan_root->goaled_root so it mints exactly once (no fight with satisfy_goal).",
   "match": [
    [
     "proc",
     "plan_root",
     "root"
    ],
    [
     "ag",
     "operates_in",
     "w"
    ]
   ],
   "where": null,
   "effects": [
    [
     "del_edge",
     "proc",
     "plan_root",
     "root"
    ],
    [
     "add_edge",
     "proc",
     "goaled_root",
     "root"
    ],
    [
     "add_edge",
     "ag",
     "wants",
     "proc"
    ],
    [
     "set_attr",
     "proc",
     "satisfaction_via",
     {
      "__term__": {
       "type": "Lit",
       "value": "plan_satisfaction"
      }
     }
    ]
   ]
  },
  {
   "name": "rearm_on_reset",
   "comment": "penalty-free retry: a RESET restores goaled_root->plan_root and clears satisfied, so goal_from_procedure re-mints.",
   "match": [
    [
     "proc",
     "goaled_root",
     "root"
    ],
    [
     "ag",
     "operates_in",
     "w"
    ]
   ],
   "where": {
    "type": "Eq",
    "a": {
     "type": "Attr",
     "node": {
      "type": "Var",
      "name": "ag"
     },
     "key": "just_reset"
    },
    "b": {
     "type": "Lit",
     "value": 1.0
    }
   },
   "effects": [
    [
     "del_edge",
     "proc",
     "goaled_root",
     "root"
    ],
    [
     "add_edge",
     "proc",
     "plan_root",
     "root"
    ],
    [
     "set_attr",
     "proc",
     "satisfied",
     {
      "__term__": {
       "type": "Lit",
       "value": 0.0
      }
     }
    ]
   ]
  }
 ],
 "goals": []
}