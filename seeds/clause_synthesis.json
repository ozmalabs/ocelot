{
 "id": "clause_synthesis",
 "version": "1.0.0",
 "depends_on": [
  "self_repair"
 ],
 "description": "NOVEL clause synthesis (extension a): build a repair clause from a parameterised ClauseTemplate by splicing the fault's LIVE operands via MkDict \u2014 pure graph data, no Rust. Lets the agent fix faults it has no exact stored clause for. Generated by scripts/gen_clause_synthesis_seed.py.",
 "microtheory": {
  "name": "clause_synthesis",
  "description": "synthesise a repair clause from live operands; novel, not a stored copy"
 },
 "nodes": [],
 "edges": [],
 "productions": [],
 "rules": [
  {
   "name": "synthesize_threshold_gate",
   "comment": "NOVEL clause synthesis: for an open synth Fault (awaiting_synth>0.5) of shape threshold_gate, BUILD the corrected where clause from the fault's live operands (gate_var/gate_attr/good_thresh) via MkDict, set f.corrected, and clear awaiting_synth so repair_apply installs it. Two faults with different operands -> different clauses. Pure graph data; no stored clause copied.",
   "match": [
    [
     "a",
     "has_fault",
     "f"
    ]
   ],
   "where": {
    "type": "And",
    "items": [
     {
      "type": "Gt",
      "a": {
       "type": "Plus",
       "items": [
        {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "f"
         },
         "key": "awaiting_synth"
        },
        {
         "type": "Lit",
         "value": 0.0
        }
       ]
      },
      "b": {
       "type": "Lit",
       "value": 0.5
      }
     },
     {
      "type": "Eq",
      "a": {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "f"
       },
       "key": "shape"
      },
      "b": {
       "type": "Lit",
       "value": "threshold_gate"
      }
     }
    ]
   },
   "effects": [
    [
     "set_attr",
     "f",
     "corrected",
     {
      "__term__": {
       "type": "MkDict",
       "items": [
        {
         "type": "Lit",
         "value": "type"
        },
        {
         "type": "Lit",
         "value": "Gt"
        },
        {
         "type": "Lit",
         "value": "a"
        },
        {
         "type": "MkDict",
         "items": [
          {
           "type": "Lit",
           "value": "type"
          },
          {
           "type": "Lit",
           "value": "Attr"
          },
          {
           "type": "Lit",
           "value": "node"
          },
          {
           "type": "MkDict",
           "items": [
            {
             "type": "Lit",
             "value": "type"
            },
            {
             "type": "Lit",
             "value": "Var"
            },
            {
             "type": "Lit",
             "value": "name"
            },
            {
             "type": "Attr",
             "node": {
              "type": "Var",
              "name": "f"
             },
             "key": "gate_var"
            }
           ]
          },
          {
           "type": "Lit",
           "value": "key"
          },
          {
           "type": "Attr",
           "node": {
            "type": "Var",
            "name": "f"
           },
           "key": "gate_attr"
          }
         ]
        },
        {
         "type": "Lit",
         "value": "b"
        },
        {
         "type": "MkDict",
         "items": [
          {
           "type": "Lit",
           "value": "type"
          },
          {
           "type": "Lit",
           "value": "Lit"
          },
          {
           "type": "Lit",
           "value": "value"
          },
          {
           "type": "Attr",
           "node": {
            "type": "Var",
            "name": "f"
           },
           "key": "good_thresh"
          }
         ]
        }
       ]
      }
     }
    ],
    [
     "set_attr",
     "f",
     "awaiting_synth",
     0.0
    ]
   ]
  }
 ]
}