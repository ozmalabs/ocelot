     {"type": "Gt", "a": {"type": "Attr", "node": {"type": "Var", "name": "item"}, "key": "input_epoch"}, "b": {"type": "Attr", "node": {"type": "Var", "name": "item"}, "key": "epoch"}}
    ]
   },
